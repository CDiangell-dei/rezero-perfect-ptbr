{
  "manifest_version": 3,
  "name": "Re:ZERO Perfect Run — Legendas PT-BR",
  "version": "0.2.0",
  "description": "Exibe legendas em Português (BR) sincronizadas no player do rezeroperfect.run, com atualização via GitHub, janela, tela cheia e arquivos locais (.ass, .srt, .vtt).",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://rezeroperfect.run/*",
    "https://raw.githubusercontent.com/CDiangell-dei/rezero-perfect-ptbr/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Re:ZERO Perfect Run PT-BR",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://rezeroperfect.run/arc-*",
        "https://rezeroperfect.run/arc*.html"
      ],
      "css": [
        "content/overlay.css"
      ],
      "js": [
        "content/subtitle-parser.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
