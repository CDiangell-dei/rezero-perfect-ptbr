{"version":1,"episodeKey":"arc06-ep09","arc":"arc06","episode":"9","language":"pt-BR","sourceFormat":"ass","cues":[{"start":6.44,"end":7.7,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Por quê...","i":false,"b":false}]]},{"start":10.91,"end":12.83,"align":2,"style":"main","isSign":false,"lines":[[{"text":"É um Livro dos Mortos...","i":false,"b":false}]]},{"start":12.83,"end":15.91,"align":2,"style":"main","isSign":false,"lines":[[{"text":"O meu... não, do “Natsuki Subaru”.","i":false,"b":false}]]},{"start":17.04,"end":22.88,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Espera, um Livro dos Mortos registraria","i":false,"b":false}],[{"text":"todas","i":true,"b":false},{"text":" as vezes em que morri?","i":false,"b":false}]]},{"start":27.92,"end":31.05,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Então o que você quer fazer","i":false,"b":false}],[{"text":"de verdade, seu covarde?!","i":false,"b":false}]]},{"start":31.05,"end":33.89,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Vai olhar essa coisa ou não?!","i":false,"b":false}]]},{"start":40.4,"end":43.57,"align":2,"style":"main","isSign":false,"lines":[[{"text":"“Natsuki Subaru”, você...","i":false,"b":false}]]},{"start":72.55,"end":74.26,"align":2,"style":"main","isSign":true,"lines":[[{"text":"O que está acontecendo?","i":false,"b":false}]]},{"start":83.8,"end":85.34,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Sumiu...?","i":false,"b":false}]]},{"start":85.84,"end":87.34,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Sumiu... Sumiu...","i":false,"b":false}]]},{"start":88.72,"end":90.47,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Não há ferimento algum.","i":false,"b":false}]]},{"start":92.52,"end":95.43,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Uma memória de morrer com a barriga rasgada...","i":false,"b":false}]]},{"start":97.69,"end":99.31,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Não