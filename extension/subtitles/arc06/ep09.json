text":"suportaria a própria morte!","i":false,"b":false}]]},{"start":1157.38,"end":1159.4,"align":8,"style":"overlap","isSign":true,"lines":[[{"text":"que você com certeza ia se arrepender.","i":false,"b":false}]]},{"start":1159.4,"end":1162.69,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Não queremos morrer! Não queremos","i":false,"b":false}],[{"text":"morrer! Não queremos morrer!","i":false,"b":false}]]},{"start":1162.69,"end":1163.65,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Ei!","i":false,"b":false}]]},{"start":1163.65,"end":1166.03,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Você perdeu, Rui Arneb.","i":false,"b":false}]]},{"start":1166.9,"end":1169.95,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Admita isso logo e liberte todo mundo.","i":false,"b":false}]]},{"start":1169.95,"end":1173.24,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Liberte todas as pessoas que você devorou!","i":false,"b":false}]]},{"start":1173.24,"end":1175.12,"align":2,"style":"main","isSign":false,"lines":[[{"text":"De jeito nenhum!","i":false,"b":false}]]},{"start":1175.12,"end":1177.79,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Essa é a nossa linha de vida, sabia!","i":false,"b":false}]]},{"start":1178.17,"end":1182.09,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Se perdermos isso, você vai poder nos matar!","i":false,"b":false}]]},{"start":1182.09,"end":1185.8,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Não podemos devolvê-las se não","i":false,"b":false}],[{"text":"quisermos ser mortas!","i":false,"b":false}]]},{"start":1185.8,"end":1187.59,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Não podemos!","i":false,"b":false}]]},{"start":1187.59,"end":1188.63,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Eu...","i":false,"b":false}]]},{"start":1190.18,"end":1191.93,"align":2,"style":"main","isSign":false,"lines":[[{"text":"não vou salvar você.","i":false,"b":false}]]},{"start":1192.43,"end":1194.1,"align":2,"style":"main","isSign":false,"lines":[[{"text":"E não sinto pena de você.","i":false,"b":false}]]},{"start":1194.1,"end":1195.14,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Não...","i":false,"b":false}]]},{"start":1195.6,"end":1196.81,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Chega!","i":false,"b":false}]]},{"start":1197.69,"end":1199.06,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Vá embora logo!","i":false,"b":false}]]},{"start":1199.06,"end":1204.94,"align":2,"style":"main","isSign":false,"lines":[[{"text":"O Irmão Mais Velho ou o Segundo Irmão","i":false,"b":false}],[{"text":"podem ficar com você pra devorar!","i":false,"b":false}]]},{"start":1204.94,"end":1207.03,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Pra nós já deu!","i":false,"b":false}]]},{"start":1207.03,"end":1209.15,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Lembre-se disso, Rui Arneb!","i":false,"b":false}]]},{"start":1209.78,"end":1213.37,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Tudo o que for angustiante, tudo o que for","i":false,"b":false}],[{"text":"doloroso, é seu pra carregar!","i":false,"b":false}]]},{"start":1213.37,"end":1215.16,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Não fuja das memórias!","i":false,"b":false}]]},{"start":1219.12,"end":1222.88,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Ei. Isso não é diferente do que planejamos?","i":false,"b":false}]]},{"start":1222.88,"end":1224.55,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Nós?","i":false,"b":false}]]},{"start":1224.55,"end":1227.01,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Isso mesmo. Somos nós.","i":false,"b":false}]]},{"start":1227.3,"end":1232.72,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Não criamos o ambiente perfeito pra jogarmos","i":false,"b":false}],[{"text":"a melhor vida através do moço?","i":false,"b":false}]]},{"start":1234.05,"end":1235.68,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Você viu, não viu?","i":false,"b":false}]]},{"start":1236.02,"end":1239.14,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Você ouviu, não ouviu?","i":false,"b":false}],[{"text":"Você sentiu o cheiro, não sentiu?","i":false,"b":false}]]},{"start":1239.14,"end":1243.23,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Você sentiu na pele, não sentiu?","i":false,"b":false}],[{"text":"Você provou o gosto, não provou?","i":false,"b":false}]]},{"start":1243.23,"end":1246.57,"align":2,"style":"main","isSign":false,"lines":[[{"text":"A Autoridade de Natsuki Subaru!","i":false,"b":false}]]},{"start":1246.57,"end":1248.4,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Não diga esse nome!","i":false,"b":false}]]},{"start":1249.24,"end":1253.41,"align":2,"style":"main","isSign":false,"lines":[[{"text":"O quê? O plano não deu certo?","i":false,"b":false}]]},{"start":1253.41,"end":1256.87,"align":2,"style":"main","isSign":false,"lines":[[{"text":"O plano era entrar nele quando ficasse vazio","i":false,"b":false}]]},{"start":1256.87,"end":1259.87,"align":2,"style":"main","isSign":false,"lines":[[{"text":"e fazer todo tipo de maldade, não era?","i":false,"b":false}]]},{"start":1259.87,"end":1261.21,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Não... Não...","i":false,"b":false}]]},{"start":1261.21,"end":1262.79,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Não!","i":false,"b":false}]]},{"start":1262.79,"end":1267.46,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Espera... você está planejando guardar","i":false,"b":false}],[{"text":"a Autoridade dele só pra você?","i":false,"b":false}]]},{"start":1267.46,"end":1271.55,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Vai monopolizar o único jeito","i":false,"b":false}],[{"text":"de sermos felizes?!","i":false,"b":false}]]},{"start":1271.55,"end":1276.31,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Não! Não, não, não! Não é isso!","i":false,"b":false}]]},{"start":1276.31,"end":1278.93,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Nós não vamos aceitar isso!","i":false,"b":false}]]},{"start":1279.85,"end":1283.19,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Natsuki Subaru pertence a nós!","i":false,"b":false}]]},{"start":1283.19,"end":1285.4,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Não sabemos do que você está falando!","i":false,"b":false}]]},{"start":1285.4,"end":1289.23,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Nós somos as únicas que conhecem Natsuki Subaru!","i":false,"b":false}]]},{"start":1289.23,"end":1291.53,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Sua destruidora de lares!","i":false,"b":false}]]},{"start":1291.95,"end":1293.78,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Sua mulher estúpida!","i":false,"b":false}]]},{"start":1293.78,"end":1295.44,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Sua monopolizadora imunda!","i":false,"b":false}]]},{"start":1295.44,"end":1297.62,"align":2,"style":"overlap","isSign":false,"lines":[[{"text":"Você não sabe de nada!","i":false,"b":false}]]},{"start":1297.62,"end":1302.58,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Se não quer, então deixe a gente provar também!","i":false,"b":false}]]},{"start":1303.96,"end":1305.71,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Nós não queremos morrer!","i":false,"b":false}]]},{"start":1306.34,"end":1307.75,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Icicle Line!","i":false,"b":false}]]},{"start":1326.23,"end":1330.44,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Desculpe, senhorita. Já nos cansamos disso.","i":false,"b":false}]]},{"start":1330.78,"end":1333.78,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Acha mesmo que vai vencer se fizer","i":false,"b":false}],[{"text":"isso apenas umas cem vezes?","i":false,"b":false}]]},{"start":1333.78,"end":1336.32,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Nem mil vezes seriam suficientes.","i":false,"b":false}]]},{"start":1336.7,"end":1339.24,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Então eu faço dez mil vezes.","i":false,"b":false}]]},{"start":1340.37,"end":1341.7,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Espere aí. É perigoso demais.","i":false,"b":false}]]},{"start":1341.7,"end":1343.66,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Deixe isso comigo.","i":false,"b":false}]]},{"start":1343.66,"end":1347.21,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Quer dizer, hã... Talvez você não","i":false,"b":false}],[{"text":"saiba quem eu sou, mas...","i":false,"b":false}]]},{"start":1347.21,"end":1349.55,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Está tudo bem, Emilia-tan!","i":false,"b":false}]]},{"start":1356.84,"end":1359.39,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Meu nome é Natsuki Subaru!","i":false,"b":false}]]},{"start":1362.85,"end":1367.67,"align":2,"style":"Episode Title","isSign":true,"lines":[[{"text":"Natsuki Subaru","i":false,"b":false}]]},{"start":1363.52,"end":1366.85,"align":2,"style":"main","isSign":false,"lines":[[{"text":"E eu sou o único cavaleiro da Emilia-tan!","i":false,"b":false}]]}]}
