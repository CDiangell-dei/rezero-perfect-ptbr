:false,"lines":[[{"text":"Quantas vezes já me viu até agora?","i":false,"b":false}]]},{"start":220.01,"end":223.26,"align":2,"style":"Flashback","isSign":false,"lines":[[{"text":"Como assim?","i":false,"b":false}],[{"text":"Eu nunca vi você antes.","i":false,"b":false}]]},{"start":223.26,"end":225.29,"align":2,"style":"Flashback","isSign":false,"lines":[[{"text":"Vamos lá, rapaz.","i":false,"b":false}],[{"text":"Vai comprar ou não?","i":false,"b":false}]]},{"start":227.05,"end":230.35,"align":2,"style":"Flashback","isSign":false,"lines":[[{"text":"Desculpa, mas estou liso que dá dó!","i":false,"b":false}]]},{"start":230.35,"end":232.69,"align":2,"style":"Flashback","isSign":false,"lines":[[{"text":"Suma daqui agora!","i":false,"b":false}]]},{"start":233.81,"end":236.9,"align":2,"style":"Flashback","isSign":false,"lines":[[{"text":"...como cavaleiro, eu teria que retaliar.","i":false,"b":false}]]},{"start":238.23,"end":240.36,"align":2,"style":"Flashback","isSign":false,"lines":[[{"text":"Viva firme e forte.","i":false,"b":false}]]},{"start":240.36,"end":242.49,"align":2,"style":"Flashback","isSign":false,"lines":[[{"text":"É assim que a Caçadora de Entranhas luta.","i":false,"b":false}]]},{"start":242.49,"end":244.7,"align":2,"style":"Flashback","isSign":false,"lines":[[{"text":"A esgrima da Casa Astrea.","i":false,"b":false}]]},{"start":244.7,"end":246.95,"align":2,"style":"Flashback","isSign":false,"lines":[[{"text":"Meu nome é Emilia.","i":false,"b":false}]]},{"start":248.74,"end":251.08,"align":2,"style":"Flashback","isSign":false,"lines":[[{"text":"Nossa, que fala de derrotado.","i":false,"b":false}]]},{"start":251.08,"end":252.29,"align":2,"style":"Flashback","isSign":false,"lines":[[{"text":"Ouviu isso, irmã?","i":false,"b":false}]]},{"start":252.29,"end":255.67,"align":2,"style":"Flashback","isSign":false,"lines":[[{"text":"Sim, palavras de um verdadeiro fracassado.","i":false,"b":false}],[{"text":"Eu ouvi, Rem.","i":false,"b":false}]]},{"start":256.96,"end":259.13,"align":2,"style":"Flashback","isSign":false,"lines":[[{"text":"Minha irmã é gentil demais para o próprio bem.","i":false,"b":false}]]},{"start":261.68,"end":266.58,"align":2,"style":"Flashback","isSign":false,"lines":[[{"text":"Eu juro que vou salvar você!","i":false,"b":false}]]},{"start":272.14,"end":273.82,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Por quê...","i":false,"b":false}]]},{"start":273.82,"end":277.9,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Por que você é tão idiota, “Natsuki Subaru”?","i":false,"b":false}]]},{"start":279.1,"end":281.14,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Você não consegue fazer nada...","i":false,"b":false}]]},{"start":292.28,"end":295.08,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Com este... são oito.","i":false,"b":false}]]},{"start":300.04,"end":301.83,"align":2,"style":"Flashback","isSign":false,"lines":[[{"text":"Tudo isso, tudo isso, tudo isso!","i":false,"b":false}]]},{"start":301.83,"end":304.96,"align":2,"style":"Flashback","isSign":false,"lines":[[{"text":"Tudo isso foi porque eu estava lá!","i":false,"b":false}]]},{"start":310.18,"end":312.64,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Onde... Onde está?","i":false,"b":false}]]},{"start":313.06,"end":315.65,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Mas... Mas que diabos é isso?","i":false,"b":false}]]},{"start":315.65,"end":317.15,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Tem que haver alguma coisa.","i":false,"b":false}]]},{"start":317.15,"end":321.86,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Algo que mostre a diferença","i":false,"b":false}],[{"text":"entre mim e o “Natsuki Subaru”!","i":false,"b":false}]]},{"start":325.3,"end":330.02,"align":2,"style":"Flashback","isSign":false,"lines":[[{"text":"Ou talvez você me conheça melhor","i":false,"b":false}],[{"text":"como a Bruxa da Ganância?","i":false,"b":false}]]},{"start":330.02,"end":331.6,"align":2,"style":"Flashback","isSign":false,"lines":[[{"text":"Dê o seu melhor!","i":false,"b":false}]]},{"start":331.6,"end":334.11,"align":2,"style":"Flashback","isSign":false,"lines":[[{"text":"Estou esperando o melhor de você, filho.","i":false,"b":false}]]},{"start":335.56,"end":336.94,"align":2,"style":"Flashback","isSign":false,"lines":[[{"text":"Tome cuidado.","i":false,"b":false}]]},{"start":337.57,"end":339.24,"align":2,"style":"Flashback","isSign":false,"lines":[[{"text":"Você prometeu, não prometeu?","i":false,"b":false}]]},{"start":339.24,"end":344.82,"align":2,"style":"Flashback","isSign":false,"lines":[[{"text":"Que cuidaria bem das suas entranhas","i":false,"b":false}],[{"text":"até nos encontrarmos de novo.","i":false,"b":false}]]},{"start":358.05,"end":361.26,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Pai... Mãe...","i":false,"b":false}]]},{"start":373.53,"end":376.53,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Me diga, “Natsuki Subaru”...","i":false,"b":false}]]},{"start":377.16,"end":379.66,"align":2,"style":"main","isSign":false,"lines":[[{"text":"O que fez de você tão especial?","i":false,"b":false}]]},{"start":380.37,"end":384.12,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Por que só você","i":false,"b":false}],[{"text":"pode ser especial?","i":false,"b":false}]]},{"start":384.54,"end":388.0,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Deve ter... Deve ter havido alguma coisa!","i":false,"b":false}]]},{"start":398.3,"end":401.18,"align":2,"style":"Flashback","isSign":false,"lines":[[{"text":"Eu... juro...","i":true,"b":false}]]},{"start":402.43,"end":405.89,"align":2,"style":"Flashback","isSign":false,"lines":[[{"text":"que vou salvar você.","i":true,"b":false}]]},{"start":408.1,"end":412.07,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Porque, se não houver, então não","i":false,"b":false}],[{"text":"tenho escolha a não ser admitir...","i":false,"b":false}]]},{"start":413.78,"end":421.03,"align":2,"style":"main","isSign":false,"lines":[[{"text":"...que você é tão fraco, patético","i":false,"b":false}],[{"text":"e impotente quanto eu.","i":false,"b":false}]]},{"start":422.2,"end":424.5,"align":2,"style":"Flashback","isSign":false,"lines":[[{"text":"Escolha a mim, Beatrice.","i":false,"b":false}]]},{"start":425.12,"end":429.33,"align":2,"style":"Flashback","isSign":false,"lines":[[{"text":"Apenas continue segurando minha mão","i":false,"b":false}],[{"text":"e não me deixe sozinha, eu suponho.","i":false,"b":false}]]},{"start":429.33,"end":431.13,"align":2,"style":"Flashback","isSign":false,"lines":[[{"text":"Muito obrigada! Sinto muito!","i":false,"b":false}]]},{"start":431.13,"end":434.76,"align":2,"style":"Flashback","isSign":false,"lines":[[{"text":"Eu sou a Arcebispa do Pecado","i":false,"b":false}],[{"text":"da Ira do Culto da Bruxa…","i":false,"b":false}]]},{"start":435.26,"end":438.8,"align":2,"style":"Flashback","isSign":false,"lines":[[{"text":"Sirius Romanée-Conti.","i":false,"b":false}]]},{"start":436.55,"end":440.93,"align":8,"style":"Flashback","isSign":true,"lines":[[{"text":"Eu quero que o maior número de pessoas,","i":false,"b":false}],[{"text":"pelo maior tempo e o mais profundamente…","i":false,"b":false}]]},{"start":439.3,"end":441.68,"align":2,"style":"Flashback","isSign":false,"lines":[[{"text":"Quem você pensa que eu sou?!","i":false,"b":false}]]},{"start":440.93,"end":443.06,"align":8,"style":"Flashback","isSign":true,"lines":[[{"text":"me amem!","i":false,"b":false}]]},{"start":441.68,"end":445.22,"align":2,"style":"Flashback","isSign":false,"lines":[[{"text":"Eu sou o Arcebispo do Pecado","i":false,"b":false}],[{"text":"da Ganância do Culto da Bruxa,","i":false,"b":false}]]},{"start":445.22,"end":447.35,"align":2,"style":"Flashback","isSign":false,"lines":[[{"text":"Regulus Corneas!","i":false,"b":false}]]},{"start":447.35,"end":448.73,"align":2,"style":"Flashback","isSign":false,"lines":[[{"text":"O Julius-san…","i":false,"b":false}]]},{"start":448.73,"end":450.65,"align":2,"style":"Flashback","isSign":false,"lines":[[{"text":"é seu amigo, Subaru?","i":false,"b":false}]]},{"start":450.65,"end":451.65,"align":2,"style":"Flashback","isSign":false,"lines":[[{"text":"Echidna.","i":false,"b":false}]]},{"start":454.44,"end":456.53,"align":2,"style":"Flashback","isSign":false,"lines":[[{"text":"Subaru! Subaru!","i":false,"b":false}]]},{"start":462.24,"end":465.83,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Estou implorando, “Natsuki Subaru”...","i":false,"b":false}]]},{"start":466.2,"end":469.16,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Por favor, me diga que você era","i":false,"b":false}],[{"text":"algum tipo de super-homem!","i":false,"b":false}]]},{"start":472.79,"end":478.07,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Me convença de que você realizou coisas...","i":false,"b":false}]]},{"start":478.07,"end":480.53,"align":2,"style":"main","isSign":false,"lines":[[{"text":"que o eu atual jamais conseguiria!","i":false,"b":false}]]},{"start":485.18,"end":486.6,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Ainda assim...","i":false,"b":false}]]},{"start":487.31,"end":491.94,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Você entende, não entende, “Natsuki Subaru”?!","i":false,"b":false}]]},{"start":492.48,"end":494.06,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Sim, eu entendo.","i":false,"b":false}]]},{"start":510.66,"end":513.5,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Eu entendo, Natsuki Subaru.","i":false,"b":false}]]},{"start":516.92,"end":520.38,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Você é eu, afinal de contas.","i":false,"b":false}]]},{"start":520.88,"end":522.76,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Vamos recomeçar.","i":false,"b":false}]]},{"start":524.26,"end":526.06,"align":2,"style":"main","isSign":false,"lines":[[{"text":"E aí, irmão.","i":false,"b":false}]]},{"start":527.14,"end":530.68,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Na verdade, acho que “irmão” pode confundir.","i":false,"b":false}]]},{"start":530.68,"end":532.39,"align":2,"style":"main","isSign":false,"lines":[[{"text":"É melhor eu ser mais específico.","i":false,"b":false}]]},{"start":533.44,"end":536.11,"align":2,"style":"main","isSign":false,"lines":[[{"text":"E aí, outro eu.","i":false,"b":false}]]},{"start":537.61,"end":540.49,"align":2,"style":"main","isSign":false,"lines":[[{"text":"”Natsuki... Subaru”?","i":false,"b":false}]]},{"start":540.49,"end":542.78,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Por que você está aqui?!","i":false,"b":false}]]},{"start":542.78,"end":545.07,"align":2,"style":"main","isSign":false,"lines":[[{"text":"E que lugar é este, afinal?!","i":false,"b":false}]]},{"start":545.07,"end":547.62,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Por que eu estou aqui?!","i":false,"b":false}]]},{"start":547.62,"end":550.54,"align":2,"style":"main","isSign":false,"lines":[[{"text":"É a prova de que você me alcançou.","i":false,"b":false}]]},{"start":551.37,"end":553.71,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Eu... alcancei você?","i":false,"b":false}]]},{"start":553.71,"end":554.92,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Pois é.","i":false,"b":false}]]},{"start":554.92,"end":558.67,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Você me alcançou lendo","i":false,"b":false}],[{"text":"os meus Livros dos Mortos.","i":false,"b":false}]]},{"start":558.67,"end":563.72,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Tudo o que você não sabia,","i":false,"b":false}],[{"text":"acabou vivenciando por tabela...","i":false,"b":false}]]},{"start":564.3,"end":566.68,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Minha vida em outro mundo.","i":false,"b":false}]]},{"start":568.56,"end":570.85,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Pare de tirar onda comigo!","i":false,"b":false}]]},{"start":570.85,"end":575.1,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Eu ainda não sei a coisa","i":false,"b":false}],[{"text":"mais importante de todas!","i":false,"b":false}]]},{"start":575.1,"end":576.19,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Me diga...","i":false,"b":false}]]},{"start":576.19,"end":578.52,"align":2,"style":"main","isSign":false,"lines":[[{"text":"O que transformou você em você?!","i":false,"b":false}]]},{"start":578.98,"end":582.74,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Eu não vi essa parte! Não encontrei!","i":false,"b":false}]]},{"start":583.99,"end":586.2,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Você deve ter visto com seus próprios olhos, né?","i":false,"b":false}]]},{"start":586.91,"end":590.24,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Pare de olhar pra mim desse jeito!","i":false,"b":false}]]},{"start":596.29,"end":599.59,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Esse poder é mesmo tão grandioso assim?!","i":false,"b":false}]]},{"start":600.88,"end":603.34,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Ele só me faz recomeçar quando eu morro!","i":false,"b":false}]]},{"start":603.34,"end":607.09,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Se o cara que usa for um lixo,","i":false,"b":false}],[{"text":"o resultado vai ser um lixo também!","i":false,"b":false}]]},{"start":607.76,"end":609.91,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Por isso não consegui salvar ninguém!","i":false,"b":false}]]},{"start":609.91,"end":611.72,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Deixei todo mundo morrer!","i":false,"b":false}]]},{"start":611.72,"end":616.44,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Não salvei ninguém, não importa quantas vezes","i":f