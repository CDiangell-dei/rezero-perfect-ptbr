{"version":1,"episodeKey":"arc03-ep06","arc":"arc03","episode":"6","language":"pt-BR","sourceFormat":"ass","cues":[{"start":6.99,"end":8.98,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Capitão?","i":false,"b":false}]]},{"start":12.89,"end":14.04,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Como?","i":false,"b":false}]]},{"start":14.04,"end":15.47,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Acabou tudo...","i":false,"b":false}]]},{"start":15.47,"end":16.66,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Estamos mortos.","i":false,"b":false}]]},{"start":19.93,"end":21.91,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Não deixem que ela engula ele!","i":false,"b":false}]]},{"start":23.56,"end":27.09,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Se soltarmos ele antes de ser engolido, dá pra salvar!","i":false,"b":false}]]},{"start":34.71,"end":35.51,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Subaru-kun...","i":false,"b":false}]]},{"start":37.53,"end":42.23,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Não ache que um pouco de desespero basta pra me parar!","i":false,"b":false}]]},{"start":42.58,"end":44.61,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Desistir não combina com a gente!","i":false,"b":false}]]},{"start":44.61,"end":46.48,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Nem comigo, nem com você!","i":false,"b":false}]]},{"start":46.48,"end":48.31,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Nem com nenhum de nós!","i":false,"b":false}]]},{"start":71.96,"end":73.87,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Vamos, Patrasche!","i":false,"b":false}]]},{"start":73.87,"end":76.3,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Corre bem debaixo do focinho da Baleia!","i":false,"b":false}]]},{"start":80.64,"end":84.6,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"A única que pode cheirar o Subaru-kun sou eu!","i":false,"b":false}]]},{"start":93.4,"end":94.65,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Feche a boca!","i":false,"b":false}]]},{"start":97.79,"end":100.7,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"À primeira vista, a situação parece sombria.","i":false,"b":false}]]},{"start":100.7,"end":101.94,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Onde está Wilhelm?","i":false,"b":false}]]},{"start":101.94,"end":104.02,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Se você se lembra dele,","i":false,"b":false}]]},{"start":104.02,"end":106.79,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"ao menos sabemos que a névoa não o apagou.","i":false,"b":false}]]},{"start":107.37,"end":110.31,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Tudo depende de quão bem a Rem lutar.","i":false,"b":false}]]},{"start":112.17,"end":114.27,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"O que acha, Natsuki Subaru?","i":false,"b":false}]]},{"start":114.27,"end":115.85,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Nada lhe parece estranho?","i":false,"b":false}]]},{"start":115.85,"end":117.15,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Estranho?","i":false,"b":false}]]},{"start":117.15,"end":119.28,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Agora há três Baleias Brancas.","i":false,"b":false}]]},{"start":119.28,"end":123.72,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Se fosse mesmo uma mabesta que vive em bando,","i":false,"b":false}],[{"text":"como não saberíamos disso até hoje?","i":false,"b":false}]]},{"start":124.35,"end":125.93,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Deve haver algum truque por trás disso.","i":false,"b":false}]]},{"start":127.06,"end":129.4,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"E precisamos descobrir qual é, né?","i":false,"b":false}]]},{"start":130.35,"end":132.59,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Se não descobrirmos, não aguentaremos por muito tempo.","i":false,"b":false}]]},{"start":132.59,"end":134.01,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Precisamos fazer algo.","i":false,"b":false}]]},{"start":134.01,"end":137.1,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Recuar já não é mais uma opção.","i":false,"b":false}]]},{"start":138.56,"end":139.71,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Fogo!","i":false,"b":false}]]},{"start":142.68,"end":144.66,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"\"Fogo\", eu disse!","i":false,"b":false}]]},{"start":149.8,"end":151.42,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Crusch-san!","i":false,"b":false}]]},{"start":174.46,"end":176.94,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Força de vontade!","i":false,"b":false}]]},{"start":179.4,"end":182.17,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Droga... Ser só destemido não basta!","i":false,"b":false}]]},{"start":182.17,"end":183.48,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Tenho que usar a cabeça!","i":false,"b":false}]]},{"start":183.48,"end":184.98,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Por que existem três delas?","i":false,"b":false}]]},{"start":184.98,"end":186.2,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Abaixe-se!","i":false,"b":false}]]},{"start":202.33,"end":203.47,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Uau!","i":false,"b":false}]]},{"start":203.47,"end":206.26,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Incrível!","i":false,"b":false}]]},{"start":207.81,"end":210.94,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Todos nós daremos cobertura a Natsuki-san e Crusch-san","i":false,"b":false}]]},{"start":211.54,"end":214.69,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"até o capitão ser totalmente curado e podermos nos reagrupar.","i":false,"b":false}]]},{"start":215.03,"end":217.19,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"O Ricardo ainda está vivo?","i":false,"b":false}]]},{"start":217.19,"end":221.93,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Sim, minha irmã o levou até Felix-san.","i":false,"b":false}]]},{"start":221.93,"end":223.66,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Ele se debateu um montão! Não foi fácil!","i":false,"b":false}]]},{"start":223.66,"end":226.6,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Entendi... Que alívio.","i":false,"b":false}]]},{"start":226.6,"end":229.12,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"À beira da morte, nosso capitão mandou um recado.","i":false,"b":false}]]},{"start":229.64,"end":231.58,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"\"Ei, tá ficando bem mais leve.","i":false,"b":false}]]},{"start":231.58,"end":235.77,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"O fato de eu não ter morrido prova isso!\"","i":false,"b":false}]]},{"start":235.77,"end":236.75,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Foi o que ele disse.","i":false,"b":false}]]},{"start":236.75,"end":238.3,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"\"Mais leve\"?","i":false,"b":false}]]},{"start":240.19,"end":244.4,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"O que tem de leve numa situação dura e pesada como esta?","i":false,"b":false}]]},{"start":247.93,"end":248.85,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Leve?","i":false,"b":false}]]},{"start":257.94,"end":261.53,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"É isso... Saquei!","i":false,"b":false}]]},{"start":261.53,"end":262.49,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Hã?","i":false,"b":false}]]},{"start":270.11,"end":270.83,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"O quê?","i":false,"b":false}]]},{"start":299.06,"end":299.98,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Wilhelm-san!","i":false,"b":false}]]},{"start":302.15,"end":304.06,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Ainda tenho muito a aprender.","i":false,"b":false}]]},{"start":304.06,"end":306.18,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Fui descuidado...","i":false,"b":false}]]},{"start":306.18,"end":307.7,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Ele está bem?!","i":false,"b":false}]]},{"start":308.14,"end":310.67,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Sim, só está inconsciente!","i":false,"b":false}]]},{"start":310.67,"end":312.87,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Desculpe, mas pode levar ele pro Ferris?","i":false,"b":false}]]},{"start":312.87,"end":314.83,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Claro! E quanto a você?","i":false,"b":false}]]},{"start":316.17,"end":317.88,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Eu percebi uma coisa...","i":false,"b":false}]]},{"start":325.07,"end":326.72,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Ela se dividiu?","i":false,"b":false}]]},{"start":327.12,"end":328.31,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"É.","i":false,"b":false}]]},{"start":328.31,"end":332.58,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"A força de combate dela e o olho esquerdo","i":false,"b":false}],[{"text":"que Wilhelm-san arrancou me convenceram.","i":false,"b":false}]]},{"start":332.58,"end":336.23,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Seu grupo tem lutado de frente com ela, então devem ter notado.","i":false,"b":false}]]},{"start":336.9,"end":339.28,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Eu estava absorta na batalha, mas...","i":false,"b":false}]]},{"start":339.28,"end":340.34,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Você tem razão.","i":false,"b":false}]]},{"start":340.34,"end":344.66,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Concordo com sua hipótese de que estas","i":false,"b":false}],[{"text":"são mais fracas que a primeira que enfrentamos.","i":false,"b":false}]]},{"start":344.66,"end":347.53,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Mas de que adianta saber disso?","i":false,"b":false}]]},{"start":347.53,"end":351.99,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Matar três Baleias Brancas é muito mais fácil falar do que fazer.","i":false,"b":false}]]},{"start":352.42,"end":354.83,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Não precisamos matar todas as três.","i":false,"b":false}]]},{"start":354.83,"end":357.02,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Só uma já deve bastar.","i":false,"b":false}]]},{"start":357.02,"end":359.8,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Aquela desgraçada pôs as duas cópias pra lutar,","i":false,"b":false}]]},{"start":359.8,"end":362.71,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"enquanto fica pairando lá em cima, só assistindo.","i":false,"b":false}]]},{"start":363.22,"end":365.92,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"O que exatamente acha que ela está fazendo com isso?","i":false,"b":false}]]},{"start":367.11,"end":369.14,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Aquela é a verdadeira?","i":false,"b":false}]]},{"start":369.14,"end":374.03,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Ela não desce porque sabe que não pode se dar ao luxo de morrer.","i":false,"b":false}]]},{"start":374.03,"end":375.14,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Mas...","i":false,"b":false}]]},{"start":376.48,"end":379.85,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Não posso contar com minha espada para acertar a essa distância.","i":false,"b":false}]]},{"start":380.25,"end":383.22,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Se eu tivesse um golpe que alcançasse, talvez fosse possível...","i":false,"b":false}]]},{"start":384.16,"end":386.19,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Eu tenho um plano.","i":false,"b":false}]]},{"start":386.78,"end":390.28,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Pra falar a verdade, é uma aposta bem alta, porém.","i":false,"b":false}]]},{"start":390.28,"end":391.91,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Você topa?","i":false,"b":false}]]},{"start":403.04,"end":404.8,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Acho que você é louco.","i":false,"b":false}]]},{"start":405.29,"end":410.18,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Já somos loucos só por encarar aquela coisa enorme.","i":false,"b":false}]]},{"start":412.18,"end":413.7,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Talvez.","i":false,"b":false}]]},{"start":413.7,"end":415.69,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Não, tem razão.","i":false,"b":false}]]},{"start":415.69,"end":418.31,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Isso vale para todos aqui neste momento.","i":false,"b":false}]]},{"start":420.71,"end":421.94,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Saiam da frente!","i":false,"b":false}]]},{"start":429.19,"end":431.2,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Nós seguraremos as duas cópias.","i":false,"b":false}]]},{"start":432.95,"end":434.66,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Eu topo. Aceito a sua aposta.","i":false,"b":false}]]},{"start":440.79,"end":442.33,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Estão vindo pra cá...","i":false,"b":false}]]},{"start":442.33,"end":444.25,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Fiquem longe!","i":false,"b":false}]]},{"start":444.25,"end":445.67,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Corram!","i":false,"b":false}]]},{"start":445.67,"end":447.24,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Vamos ser dizimados...","i":false,"b":false}]]},{"start":475.18,"end":476.58,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Crusch-sama!","i":false,"b":false}]]},{"start":479.5,"end":482.25,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Levantem-se! Ergam as cabeças!","i":false,"b":false}]]},{"start":482.25,"end":483.21,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Empunhem suas armas!","i":false,"b":false}]]},{"start":484.17,"end":485.67,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Olhem para aquele rapaz.","i":false,"b":false}]]},{"start":485.67,"end":490.18,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"É tão fraco e frágil que um sopro poderia derrubá-lo, e está desarmado!","i":false,"b":false}]]},{"start":490.18,"end":493.59,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"É um rapaz sem poder, cuja derrota eu vi com meus próprios olhos!","i":false,"b":false}]]},{"start":494.35,"end":497.78,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Ele é mais fraco do que qualquer um aqui!","i":false,"b":false}]]},{"start":497.78,"end":499.56,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Ainda assim, grita mais alto do que todos","i":false,"b":false}]]},{"start":500.58,"end":502.27,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"que ainda podemos vencer!","i":false,"b":false}]]},{"start":503.48,"end":506.98,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Então como podemos ficar aqui sentados, encarando o chão?","i":false,"b":false}]]},{"start":506.98,"end":509.95,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Se o mais fraco entre nós não desistiu,","i":false,"b":false}]]},{"start":509.95,"end":513.53,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"como podemos abaixar a cabeça e aceitar a derrota?","i":false,"b":false}]]},{"start":518.07,"end":520.41,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Vieram todos tão longe","i":false,"b":false}]]},{"start":522.58,"end":525.21,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"para chafurdar na própria vergonha?!","i":false,"b":false}]]},{"start":553.35,"end":554.66,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Avançar!","i":false,"b":false}]]},{"start":568.0,"end":572.59,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Ela tem coragem de sobra, me chamando de fracote e perdedor...","i":false,"b":false}]]},{"start":574.72,"end":576.22,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Vamos nessa, Rem.","i":false,"b":false}]]},{"start":576.55,"end":577.75,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Hora do clímax!","i":false,"b":false}]]},{"start":577.75,"end":580.18,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Certo, Subaru-kun.","i":false,"b":false}]]},{"start":587.32,"end":588.35,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Al Huma!","i":true,"b":false}]]},{"start":595.05,"end":595.74,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Por favor!","i":false,"b":false}]]},{"start":605.27,"end":606.46,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Conto com você.","i":false,"b":false}]]},{"start":608.31,"end":613.94,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Ei... Agora que te vejo de perto, você é bem nojenta, sabia?","i":false,"b":false}]]},{"start":618.68,"end":620.6,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Tenta acompanhar meu ritmo.","i":false,"b":false}]]},{"start":620.6,"end":626.14,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Pra constar, sou famoso por ser chato a ponto de ninguém me ignorar!","i":false,"b":false}]]},{"start":630.27,"end":633.17,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Certo, vamos lá!","i":false,"b":false}]]},{"start":635.69,"end":638.86,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Estou te fazendo um baita favor! Escuta aqui!","i":false,"b":false}]]},{"start":639.2,"end":641.31,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"É por tua causa que a Rem morreu","i":false,"b":false}]]},{"start":641.31,"end":645.62,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"e que eu passei por um trauma horrível daqueles!","i":false,"b":false}]]},{"start":653.93,"end":657.21,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Eu voltei!","i":false,"b":false}]]},{"start":668.03,"end":668.77,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Rem!","i":false,"b":false}]]},{"start":669.18,"end":669.89,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Sim!","i":false,"b":false}]]},{"start":683.1,"end":684.41,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Você me salvou.","i":false,"b":false}]]},{"start":684.41,"end":685.72,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Obrigada pelo banquete.","i":false,"b":false}]]},{"start":685.72,"end":687.24,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Do que você tá falando?","i":false,"b":false}]]},{"start":695.96,"end":698.1,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Não me decepcione, Patrasche.","i":false,"b":false}]]},{"start":698.1,"end":699.51,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Você é um dragão, não é?","i":false,"b":false}]]},{"start":699.51,"end":701.72,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Mostra o quanto você é incrível!","i":false,"b":false}]]},{"start":708.49,"end":710.39,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Toma essa!","i":false,"b":false}]]},{"start":710.39,"end":712.17,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Fogo!","i":false,"b":false}]]},{"start":772.08,"end":775.46,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Isto é pela minha esposa, Theresia van Astrea.","i":false,"b":false}]]},{"start":796.72,"end":797.9,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Eu venci.","i":false,"b":false}]]},{"start":798.57,"end":802.23,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Como espadachim inferior, você já não tem razão para empunhar uma espada.","i":false,"b":false}]]},{"start":802.68,"end":805.87,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Se eu não empunhar, quem vai?","i":false,"b":false}]]},{"start":806.75,"end":811.45,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Eu herdarei sua razão para empunhar a espada.","i":false,"b":false}]]},{"start":812.58,"end":813.86,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Você precisa apenas","i":false,"b":false}]]},{"start":815.13,"end":817.67,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"se tornar minha razão para empunhá-la.","i":false,"b":false}]]},{"start":822.73,"end":826.43,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Ei, você gosta de flores?","i":false,"b":false}]]},{"start":826.43,"end":828.09,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Eu não as odeio mais.","i":false,"b":false}]]},{"start":828.09,"end":831.06,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Por que você empunha a espada?","i":false,"b":false}]]},{"start":831.93,"end":832.93,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Eu a empunho...","i":false,"b":false}]]},{"start":836.47,"end":837.89,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"para proteger você.","i":false,"b":false}]]},{"start":841.47,"end":843.78,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Você me ama?","i":false,"b":false}]]},{"start":845.54,"end":846.36,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Você sabe que sim.","i":false,"b":false}]]},{"start":847.96,"end":850.32,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Eu ainda quero ouvir você dizer às vezes.","i":false,"b":false}]]},{"start":851.53,"end":853.11,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Pois bem.","i":false,"b":false}]]},{"start":853.11,"end":854.04,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Algum dia...","i":false,"b":false}]]},{"start":855.85,"end":857.29,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Quando eu tiver vontade.","i":false,"b":false}]]},{"start":874.64,"end":877.23,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Durma por toda a eternidade.","i":false,"b":false}]]},{"start":892.8,"end":895.33,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Está feito, Theresia.","i":false,"b":false}]]},{"start":896.73,"end":898.04,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Finalmente...","i":false,"b":false}]]},{"start":898.63,"end":901.48,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Theresia, eu...","i":false,"b":false}]]},{"start":903.83,"end":904.5,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Eu...","i":false,"b":false}]]},{"start":908.76,"end":912.85,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Eu te amo!","i":false,"b":false}]]},{"start":919.48,"end":922.31,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"A Baleia Branca caiu!","i":false,"b":false}]]},{"start":922.97,"end":925.37,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"A mabesta da névoa,","i":false,"b":false}]]},{"start":925.37,"end":928.28,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"que aterrorizou o mundo por quatro séculos,","i":false,"b":false}]]},{"start":929.08,"end":933.72,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"foi abatida por Wilhelm van Astrea!","i":false,"b":false}]]},{"start":941.39,"end":944.84,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Esta batalha é a nossa vitória!","i":false,"b":false}]]},{"start":958.12,"end":960.39,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Está bem, Natsuki Subaru?","i":false,"b":false}]]},{"start":963.26,"end":965.48,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"De um jeito ou de outro...","i":false,"b":false}]]},{"start":966.25,"end":968.75,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Fico feliz que você também esteja bem, Crusch-san.","i":false,"b":false}]]},{"start":968.75,"end":970.07,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Estou, sim.","i":false,"b":false}]]},{"start":970.49,"end":974.0,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Mas nossas perdas não são poucas.","i":false,"b":false}]]},{"start":974.0,"end":976.03,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Mesmo com a derrota da Baleia Branca,","i":false,"b":false}]]},{"start":976.03,"end":978.16,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"aqueles que desapareceram não retornarão.","i":false,"b":false}]]},{"start":982.49,"end":985.45,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Acho que mandou muito bem, Crusch-san.","i":false,"b":false}]]},{"start":985.45,"end":987.78,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Sua popularidade vai disparar às—","i":false,"b":false}]]},{"start":987.78,"end":992.06,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Espera, acabei de dar um impulso pra você","i":false,"b":false}],[{"text":"na seleção real que não devia?!","i":false,"b":false}]]},{"start":992.06,"end":994.98,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Essa expressão no seu rosto está bastante sombria.","i":false,"b":false}]]},{"start":994.98,"end":997.72,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Não parece o herói que derrubou a Baleia Branca.","i":false,"b":false}]]},{"start":997.72,"end":1002.1,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"A primeira coisa que Emilia-tan vai fazer é me chamar de traidor...","i":false,"b":false}]]},{"start":1002.47,"end":1003.85,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Espera, do que acabou de me chamar?","i":false,"b":false}]]},{"start":1004.42,"end":1006.87,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"O herói que derrubou a Baleia Branca.","i":false,"b":false}]]},{"start":1007.48,"end":1009.06,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Não gostaria de ser","i":false,"b":false}]]},{"start":1009.06,"end":1013.86,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"descarada a ponto de reivindicar sua conquista como minha.","i":false,"b":false}]]},{"start":1014.36,"end":1016.45,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Não, eu não fiz nada mesmo.","i":false,"b":false}]]},{"start":1023.0,"end":1025.64,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Parece que sua opinião sobre mim melhorou bastante.","i":false,"b":false}]]},{"start":1025.64,"end":1026.58,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Estou surpreso.","i":false,"b":false}]]},{"start":1027.08,"end":1028.96,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Não há motivo para modéstia.","i":false,"b":false}]]},{"start":1028.96,"end":1031.85,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Na verdade, adoraria acolhê-lo","i":false,"b":false}]]},{"start":1031.85,"end":1035.43,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"em minha casa e recompensar seus feitos.","i":false,"b":false}]]},{"start":1035.43,"end":1037.43,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Por favor, não me peça isso!","i":false,"b":false}]]},{"start":1037.43,"end":1039.8,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Não é questão de lealdade ou obediência,","i":false,"b":false}]]},{"start":1039.8,"end":1042.89,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"mas minha fé já está exatamente onde deve estar.","i":false,"b":false}]]},{"start":1044.11,"end":1046.1,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Eu vou tornar a Emilia a governante.","i":false,"b":false}]]},{"start":1048.26,"end":1050.04,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Não pelo bem de ninguém.","i":false,"b":false}]]},{"start":1050.04,"end":1051.53,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"É simplesmente o que eu quero fazer.","i":false,"b":false}]]},{"start":1054.99,"end":1057.29,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Eu já tinha ciência disso,","i":false,"b":false}]]},{"start":1057.29,"end":1059.03,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"mas ainda arde um pouco.","i":false,"b":false}]]},{"start":1060.75,"end":1063.45,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Sinceramente, acho você uma pessoa incrível.","i":false,"b":false}]]},{"start":1063.45,"end":1067.25,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Se eu estivesse sozinho, quase certeza","i":false,"b":false}],[{"text":"que teria aceitado sua oferta.","i":false,"b":false}]]},{"start":1067.7,"end":1070.46,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Contarei com você para manter a aliança.","i":false,"b":false}]]},{"start":1070.46,"end":1073.0,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Mesmo que acabemos como inimigos,","i":false,"b":false}]]},{"start":1073.0,"end":1076.17,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"acredito que possamos nos dar bem até lá.","i":false,"b":false}]]},{"start":1077.87,"end":1081.89,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Natsuki Subaru, permita-me corrigir uma ideia que você tem.","i":false,"b":false}]]},{"start":1082.81,"end":1085.69,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Mesmo que nos encontremos em conflito um dia,","i":false,"b":false}]]},{"start":1085.69,"end":1088.6,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"permanecerei amigável com você.","i":false,"b":false}]]},{"start":1089.05,"end":1092.14,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Mesmo que o dia em que devamos acertar as contas chegue,","i":false,"b":false}]]},{"start":1092.14,"end":1095.07,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"não esquecerei a dívida que contraí hoje.","i":false,"b":false}]]},{"start":1095.66,"end":1098.03,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Portanto, mesmo se nos tornarmos inimigos,","i":false,"b":false}]]},{"start":1098.58,"end":1102.99,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"eu o respeitarei e lhe mostrarei estima até o fim.","i":false,"b":false}]]},{"start":1107.32,"end":1110.65,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Se eu já não tivesse a número um e a número dois no coração,","i":false,"b":false}]]},{"start":1110.65,"end":1112.42,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"estaria em apuros agora.","i":false,"b":false}]]},{"start":1114.5,"end":1118.52,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Não fui tão longe a ponto de pensar em você como uma mulher pensaria.","i":false,"b":false}]]},{"start":1118.52,"end":1122.01,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Não nego que houve ocasiões em que meu coração se sentiu tocado,","i":false,"b":false}]]},{"start":1122.01,"end":1124.68,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"mas meu coração repousa ao fim do meu sonho.","i":false,"b":false}]]},{"start":1134.09,"end":1134.78,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Agora...","i":false,"b":false}]]},{"start":1135.39,"end":1140.74,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Partirei para levar nossos feridos e a carcaça","i":false,"b":false}],[{"text":"da Baleia Branca à capital.","i":false,"b":false}]]},{"start":1141.46,"end":1144.95,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Mas parece que você ainda tem um dever a cumprir.","i":false,"b":false}]]},{"start":1144.95,"end":1146.38,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"É.","i":false,"b":false}]]},{"start":1146.38,"end":1147.74,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Pode soar grosseiro,","i":false,"b":false}]]},{"start":1147.74,"end":1150.67,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"mas, de certo modo, essa caçada à baleia era sobre isso mesmo.","i":false,"b":false}]]},{"start":1150.67,"end":1151.64,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Oh?","i":false,"b":false}]]},{"start":1151.64,"end":1154.02,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Subjugar a Baleia Branca era secundário?","i":false,"b":false}]]},{"start":1154.02,"end":1155.53,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Intrigante.","i":false,"b":false}]]},{"start":1156.6,"end":1157.63,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Precisa de assistência?","i":false,"b":false}]]},{"start":1158.02,"end":1159.74,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Preciso.","i":false,"b":false}]]},{"start":1159.74,"end":1160.59,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Mas...","i":false,"b":false}]]},{"start":1161.08,"end":1164.52,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Francamente, não esperava que a caçada cobrasse um preço desses.","i":false,"b":false}]]},{"start":1165.36,"end":1166.06,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Além disso—","i":false,"b":false}]]},{"start":1166.06,"end":1169.94,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Nesse caso, por que não faz uso deste velho?","i":false,"b":false}]]},{"start":1174.28,"end":1175.94,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Natsuki Subaru-dono,","i":false,"b":false}]]},{"start":1176.73,"end":1178.36,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"com esta subjugação,","i":false,"b":false}]]},{"start":1178.87,"end":1183.82,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"foi por sua causa que pude cumprir a razão","i":false,"b":false}]]},{"start":1183.82,"end":1185.69,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"de eu ter vivido por todo este tempo.","i":false,"b":false}]]},{"start":1185.69,"end":1187.46,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Eu lhe agradeço...","i":false,"b":false}]]},{"start":1187.46,"end":1188.33,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Eu lhe agradeço.","i":false,"b":false}]]},{"start":1189.61,"end":1193.29,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Agradeço-lhe com todo o meu ser!","i":false,"b":false}]]},{"start":1196.98,"end":1200.89,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Foi a sua força que tornou isso possível, Wilhelm-san.","i":false,"b":false}]]},{"start":1200.89,"end":1204.3,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"O senhor estava tão decidido a derrotar","i":false,"b":false}],[{"text":"a Baleia Branca que lutou sem descanso.","i":false,"b":false}]]},{"start":1205.36,"end":1208.24,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Não sei se cabe a mim dizer isso, mas...","i":false,"b":false}]]},{"start":1208.24,"end":1209.88,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Parabéns.","i":false,"b":false}]]},{"start":1209.88,"end":1213.3,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"E obrigado pelo seu serviço.","i":false,"b":false}]]},{"start":1213.3,"end":1217.23,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Acredito que conseguiu fazer isso porque amava sua esposa loucamente.","i":false,"b":false}]]},{"start":1219.47,"end":1220.84,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Eu lhe agradeço...","i":false,"b":false}]]},{"start":1225.92,"end":1230.39,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Fique com essa sua estimada espada por um tempo.","i":false,"b":false}]]},{"start":1230.39,"end":1233.12,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Nos dias que virão, estar desarmado pouco lhe servirá.","i":false,"b":false}]]},{"start":1233.12,"end":1234.99,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Sim, minha senhora. Obrigado.","i":false,"b":false}]]},{"start":1234.99,"end":1238.49,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Leve Ferris e metade dos ilesos.","i":false,"b":false}]]},{"start":1238.49,"end":1240.39,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Devem somar cerca de vinte.","i":false,"b":false}]]},{"start":1240.39,"end":1241.26,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Tem certeza?","i":false,"b":false}]]},{"start":1241.84,"end":1244.87,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Eu lhe disse que não desejo ser descarada.","i":false,"b":false}]]},{"start":1244.87,"end":1246.39,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"E que o respeitaria.","i":false,"b":false}]]},{"start":1250.32,"end":1251.47,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Obrigado.","i":false,"b":false}]]},{"start":1254.75,"end":1255.77,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Por quê?","i":false,"b":false}]]},{"start":1256.24,"end":1258.15,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Você","i":false,"b":false},{"text":" nyão","i":true,"b":false},{"text":" consegue se mexer, certo?","i":false,"b":false}]]},{"start":1259.86,"end":1263.96,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Como usuário de magia de cura, não posso deixá-la se forçar mais!","i":false,"b":false}]]},{"start":1263.96,"end":1265.08,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Você vai ficar para trás—","i":false,"b":false}]]},{"start":1265.08,"end":1266.03,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Mas...","i":false,"b":false}]]},{"start":1266.03,"end":1268.43,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"E-Ei, cuidado!","i":false,"b":false}]]},{"start":1268.43,"end":1271.66,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Por favor, obedeça ao Ferris e não exagere.","i":false,"b":false}]]},{"start":1271.66,"end":1272.92,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Não vou.","i":false,"b":false}]]},{"start":1272.92,"end":1275.29,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Dói demais... Não aguento.","i":false,"b":false}]]},{"start":1275.64,"end":1277.62,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Quando você estiver em apuros,","i":false,"b":false}]]},{"start":1277.62,"end":1280.96,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"eu quero ser a primeira a estender a mão para você.","i":false,"b":false}]]},{"start":1281.42,"end":1284.44,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Isso é tudo o que quero! Então, por favor...","i":false,"b":false}]]},{"start":1284.44,"end":1287.0,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Nesse caso, não precisa se preocupar.","i":false,"b":false}]]},{"start":1288.52,"end":1291.43,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Você já me salvou tantas vezes.","i":false,"b":false}]]},{"start":1292.86,"end":1297.35,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Não percebe o quanto já fez por mim até agora?","i":false,"b":false}]]},{"start":1297.35,"end":1300.57,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Quero que me ajude daqui pra frente também.","i":false,"b":false}]]},{"start":1300.57,"end":1303.65,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Então, desta vez, deixe tudo comigo.","i":false,"b":false}]]},{"start":1305.96,"end":1309.12,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Depois disso, ainda vai me manter ao seu lado?","i":false,"b":false}]]},{"start":1310.66,"end":1312.87,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Eu é que deveria estar implorando pra você ficar.","i":false,"b":false}]]},{"start":1316.59,"end":1319.04,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Vou tomar isso como uma promessa.","i":false,"b":false}]]},{"start":1319.04,"end":1321.75,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Não pode mais voltar atrás agora.","i":false,"b":false}]]},{"start":1326.2,"end":1328.0,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Vai ficar tudo bem, Rem.","i":false,"b":false}]]},{"start":1328.0,"end":1330.39,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Vou dar um jeito de cuidar de tudo!","i":false,"b":false}]]},{"start":1330.97,"end":1333.12,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Sou o seu herói!","i":false,"b":false}]]},{"start":1333.12,"end":1336.09,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Decidi dar esse primeiro passo!","i":false,"b":false}]]},{"start":1336.09,"end":1337.64,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Então não se preocupe com nada!","i":false,"b":false}]]},{"start":1338.17,"end":1340.39,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Consegui dar conta da caçada à baleia.","i":false,"b":false}]]},{"start":1340.39,"end":1343.99,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Agora mesmo, o seu herói está possuído pelo espírito da batalha.","i":false,"b":false}]]},{"start":1344.7,"end":1346.19,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Subaru-kun...","i":false,"b":false}]]},{"start":1351.22,"end":1352.14,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Tudo bem!","i":false,"b":false}]]},{"start":1352.98,"end":1356.82,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Meu herói é o maior do mundo!","i":false,"b":false}]]},{"start":1373.72,"end":1378.73,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Rapaz, você roubou todas as melhores partes lá atrás, viu?","i":false,"b":false}]]},{"start":1379.04,"end":1381.26,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Capitão... A Mimi também! A Mimi também!","i":false,"b":false}]]},{"start":1381.26,"end":1383.48,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Eu mandei superbem demais!","i":false,"b":false}]]},{"start":1383.48,"end":1385.96,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Você não quase morreu?","i":false,"b":false}]]},{"start":1385.96,"end":1388.56,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"E seu irmão ficou exausto.","i":false,"b":false}]]},{"start":1388.56,"end":1390.63,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Como você tem tanta energia?","i":false,"b":false}]]},{"start":1390.63,"end":1393.19,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"O Hetaro é só um bebê. Ele é fraquinho.","i":false,"b":false}]]},{"start":1393.19,"end":1395.66,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Sério, é tão patético...","i":false,"b":false}]]},{"start":1396.11,"end":1399.36,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Mais pro fim da batalha com a Baleia não fiz muita coisa,","i":false,"b":false}]]},{"start":1399.36,"end":1401.03,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"mas não esquenta.","i":false,"b":false}]]},{"start":1401.03,"end":1403.68,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"A patroa me pediu um favor, afinal.","i":false,"b":false}]]},{"start":1403.68,"end":1406.75,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Na batalha de verdade que vem aí, vou te mostrar do que sou capaz.","i":false,"b":false}]]},{"start":1406.75,"end":1409.63,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"A batalha de verdade? O que acha que estou tentando fazer aqui?","i":false,"b":false}]]},{"start":1409.63,"end":1411.84,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Você tá indo encarar o Culto da Bruxa, não tá?","i":false,"b":false}]]},{"start":1413.23,"end":1416.58,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Nunca subestime a rede de informações dos mercadores.","i":false,"b":false}]]},{"start":1416.58,"end":1417.77,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Ah, lá vêm eles.","i":false,"b":false}]]},{"start":1422.31,"end":1424.74,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Essa é a metade do nosso grupo de mercenários.","i":false,"b":false}]]},{"start":1424.74,"end":1425.77,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Metade?","i":false,"b":false}]]},{"start":1425.77,"end":1429.06,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Metade deles foi mandada pra bloquear a estrada,","i":false,"b":false}]]},{"start":1429.06,"end":1431.28,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"em vez de lutar com a Baleia.","i":false,"b":false}]]},{"start":1431.77,"end":1434.27,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Eles vão nos ajudar também?","i":false,"b":false}]]},{"start":1434.27,"end":1435.74,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Quem está liderando eles?","i":false,"b":false}]]},{"start":1435.74,"end":1438.45,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Meu irmão mais novo, Tivey!","i":false,"b":false}]]},{"start":1438.45,"end":1440.98,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Você tem outro irmão mais novo?","i":false,"b":false}]]},{"start":1440.98,"end":1445.21,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Tô bem curioso pra saber se ele é mais parecido com você ou com o Hetaro.","i":false,"b":false}]]},{"start":1451.1,"end":1452.51,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Ei!","i":false,"b":false}]]},{"start":1457.4,"end":1459.52,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Por que ","i":true,"b":false},{"text":"ele","i":false,"b":false},{"text":" tá com eles?","i":true,"b":false}]]},{"start":1462.02,"end":1465.02,"align":5,"style":"Episode Title","isSign":true,"lines":[[{"text":"Uma Aposta","i":false,"b":false}]],"role":"title"},{"start":1462.02,"end":1465.02,"align":5,"style":"Episode Title","isSign":true,"lines":[[{"text":"que Desafia","i":false,"b":false}]],"role":"title"},{"start":1462.02,"end":1465.02,"align":5,"style":"Episode Title","isSign":true,"lines":[[{"text":"o Desespero","i":false,"b":false}]],"role":"title"}]}
