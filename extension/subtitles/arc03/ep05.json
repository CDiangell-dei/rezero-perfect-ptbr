"ki ","t":275.94},{"text":"no ","t":276.1},{"text":"me","t":276.26},{"text":"i","t":276.4},{"text":"ro ","t":276.57},{"text":"han","t":276.81},{"text":"ten","t":277.14},{"text":"shi","t":277.36},{"text":"ta ","t":277.56},{"text":"kon","t":278.02},{"text":"to","t":278.33},{"text":"ra","t":278.48},{"text":"su","t":278.58},{"text":"to ","t":278.79},{"text":"e","t":278.95}]},{"start":275.19,"end":280.11,"align":2,"style":"Re:Zero OP2 - English","isSign":false,"lines":[[{"text":"fugindo deste labirinto de sanidade","i":false,"b":false}],[{"text":"rumo a um contraste invertido","i":false,"b":false}]]},{"start":286.18,"end":288.27,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"É enorme.","i":false,"b":false}]]},{"start":289.15,"end":290.43,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Está com medo?","i":false,"b":false}]]},{"start":291.81,"end":293.49,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Tô, tô com medo.","i":false,"b":false}]]},{"start":293.49,"end":295.52,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Com medo do futuro ofuscantemente brilhante","i":false,"b":false}]]},{"start":295.52,"end":297.65,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"onde vou ser venerado como herói por derrotar ela!","i":false,"b":false}]]},{"start":298.41,"end":300.78,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Agora, vamos correr pra valer!","i":false,"b":false}]]},{"start":301.17,"end":302.0,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Sim!","i":false,"b":false}]]},{"start":309.45,"end":310.67,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"É rápida demais!","i":false,"b":false}]]},{"start":321.52,"end":322.83,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Subestima-nos gravemente","i":false,"b":false}]]},{"start":322.83,"end":325.18,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"se pensa que pode desviar o olhar com tanto descuido.","i":false,"b":false}]]},{"start":325.89,"end":328.27,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Uma espada fantasma, sem se importar com a distância.","i":false,"b":false}]]},{"start":328.63,"end":330.47,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Essa é a arte da espada de Crusch-sama,","i":false,"b":false}]]},{"start":330.47,"end":332.19,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"famosa pelo seu Golpe dos Cem Homens.","i":false,"b":false}]]},{"start":356.05,"end":357.13,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Dispersar!","i":false,"b":false}]]},{"start":357.13,"end":358.59,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Dispersar!","i":false,"b":false}]]},{"start":374.65,"end":376.71,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Por quatorze longos anos,","i":false,"b":false}]]},{"start":376.71,"end":379.19,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"não sonhei com nada além deste dia.","i":false,"b":false}]]},{"start":381.41,"end":384.16,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Caia aqui, e deixe seu cadáver para trás.","i":false,"b":false}]]},{"start":396.29,"end":399.05,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Como o monstro que é!","i":false,"b":false}]]},{"start":420.06,"end":422.17,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Como é maravilhosamente cooperativo,","i":false,"b":false}]]},{"start":422.17,"end":424.19,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"vindo aqui para ser abatido!","i":false,"b":false}]]},{"start":434.75,"end":435.87,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Ah, droga!","i":false,"b":false}]]},{"start":445.81,"end":448.93,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Não desvia o olhar da gente, idiota!","i":false,"b":false}]]},{"start":450.72,"end":452.37,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Lá vamos nós!","i":false,"b":false}]]},{"start":452.37,"end":453.81,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Todos, agora!","i":false,"b":false}]]},{"start":457.44,"end":459.61,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Tropas, recuem!","i":false,"b":false}]]},{"start":466.82,"end":469.32,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Fogo! Mirem no flanco dela!","i":false,"b":false}]]},{"start":469.64,"end":471.26,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Al Goa!","i":true,"b":false}]]},{"start":489.33,"end":491.58,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Parece que funcionou muito bem!","i":false,"b":false}]]},{"start":491.58,"end":493.74,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Acho que conseguimos dar conta dela!","i":false,"b":false}]]},{"start":493.74,"end":495.89,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Não, na verdade,","i":false,"b":false}]]},{"start":495.89,"end":498.91,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"esperávamos que esse ataque a derrubasse no chão.","i":false,"b":false}]]},{"start":501.17,"end":503.61,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Ela não está perdendo altitude nenhuma...","i":false,"b":false}]]},{"start":507.35,"end":510.85,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"A gente usou nossos melhores ataques logo de cara.","i":false,"b":false}]]},{"start":510.85,"end":512.89,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Se isso não derrubou ela,","i":false,"b":false}]]},{"start":512.89,"end":515.83,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"ela é muito mais resistente do que a gente pensava.","i":false,"b":false}]]},{"start":516.36,"end":518.85,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Os ataques mágicos não funcionaram?","i":false,"b":false}]]},{"start":518.85,"end":522.54,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"O pelo branco dela dispersa mana e neutraliza a força.","i":false,"b":false}]]},{"start":522.54,"end":525.5,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Minha magia também não foi tão eficaz quanto parecia.","i":false,"b":false}]]},{"start":526.04,"end":527.16,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Fogo!","i":false,"b":false}]]},{"start":532.04,"end":533.51,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Hora da segunda investida.","i":false,"b":false}]]},{"start":533.51,"end":535.85,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Bora nessa! Vamos minar a força que sobrou nela!","i":false,"b":false}]]},{"start":545.65,"end":549.25,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Servir de isca agora causaria mais mal do que bem.","i":false,"b":false}]]},{"start":549.25,"end":552.35,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Então só nos resta assistir até ela se mexer?","i":false,"b":false}]]},{"start":552.35,"end":555.49,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Estou tão irritado quanto você.","i":false,"b":false}]]},{"start":555.91,"end":558.01,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Eu nem tenho ataques,","i":false,"b":false}]]},{"start":558.01,"end":560.57,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"então assistir já é tudo o que posso fazer mesmo.","i":false,"b":false}]]},{"start":560.57,"end":564.02,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Mas sua especialidade em cura faz de você nossa tábua de salvação.","i":false,"b":false}]]},{"start":564.02,"end":567.12,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Tudo o que precisa fazer é cumprir esse papel por nós!","i":false,"b":false}]]},{"start":567.12,"end":568.35,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Contamos com você.","i":f