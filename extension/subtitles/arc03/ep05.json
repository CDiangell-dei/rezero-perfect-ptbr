rt":1038.38,"end":1039.23,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Capitão!","i":false,"b":false}]]},{"start":1039.23,"end":1040.06,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Eu cuido disso!","i":false,"b":false}]]},{"start":1052.39,"end":1053.47,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Rem!","i":false,"b":false}]]},{"start":1061.65,"end":1064.91,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Desviando o olhar de mim? Quanta frieza sua.","i":false,"b":false}]]},{"start":1064.91,"end":1069.04,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"E pensar que passei os últimos quatorze anos","i":false,"b":false}],[{"text":"completamente alucinado por você!","i":false,"b":false}]]},{"start":1072.59,"end":1074.95,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Isso tá começando a ficar divertido.","i":false,"b":false}]]},{"start":1074.95,"end":1079.13,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"É mais resistente que o esperado, mas não tão forte assim!","i":false,"b":false}]]},{"start":1079.13,"end":1082.26,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Não, está oferecendo menos resistência do que deveria.","i":false,"b":false}]]},{"start":1083.26,"end":1086.43,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Custa-me acreditar que esta mabesta","i":false,"b":false}]]},{"start":1086.43,"end":1089.59,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"tenha vencido minha esposa, uma Santa da Espada.","i":false,"b":false}]]},{"start":1089.59,"end":1091.27,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"O fato de termos pego ela de surpresa,","i":false,"b":false}]]},{"start":1091.27,"end":1094.53,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"e de não ter usado a névoa para dividir nossas forças antes—","i":false,"b":false}]]},{"start":1100.41,"end":1102.62,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Vou levar uma lembrancinha de despedida antes de ir!","i":false,"b":false}]]},{"start":1112.8,"end":1113.97,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Wilhelm-san!","i":false,"b":false}]]},{"start":1113.97,"end":1114.92,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Fique atento!","i":false,"b":false}]]},{"start":1114.92,"end":1116.51,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Não sabemos de onde virá.","i":false,"b":false}]]},{"start":1135.86,"end":1137.37,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Ué?","i":false,"b":false}]]},{"start":1137.37,"end":1138.65,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Ela não vai vir atrás?","i":false,"b":false}]]},{"start":1145.63,"end":1146.5,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Aí vem ela.","i":false,"b":false}]]},{"start":1149.01,"end":1151.79,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"A névoa está descendo!","i":false,"b":false}]]},{"start":1163.73,"end":1164.97,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Corram!","i":false,"b":false}]]},{"start":1171.48,"end":1174.61,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Ei, passou a gostar de flores?","i":false,"b":false}]]},{"start":1177.18,"end":1178.11,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"O que houve?","i":false,"b":false}]]},{"start":1178.94,"end":1180.66,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Houve conversa de condecoração,","i":false,"b":false}]]},{"start":1180.66,"end":1181.94,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"e eu me tornei cavaleiro.","i":false,"b":false}]]},{"start":1185.67,"end":1187.8,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Bem, parabéns.","i":false,"b":false}]]},{"start":1187.8,"end":1189.46,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Então você está um passo mais perto do seu sonho.","i":false,"b":false}]]},{"start":1190.25,"end":1191.31,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Meu sonho?","i":false,"b":false}]]},{"start":1191.31,"end":1193.67,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Você não empunha uma espada para proteger?","i":false,"b":false}]]},{"start":1194.36,"end":1197.72,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Um cavaleiro é alguém que protege outra pessoa.","i":false,"b":false}]]},{"start":1207.88,"end":1210.89,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Eu não quero... morrer...","i":false,"b":false}]]},{"start":1230.52,"end":1231.83,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Que humilhação!","i":false,"b":false}]]},{"start":1233.78,"end":1235.01,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Entendo.","i":false,"b":false}]]},{"start":1235.01,"end":1236.98,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Você estava rindo de mim?!","i":false,"b":false}]]},{"start":1238.34,"end":1240.85,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Responda-me, Theresia!","i":false,"b":false}]]},{"start":1240.85,"end":1241.47,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Não...","i":false,"b":false}]]},{"start":1242.84,"end":1245.59,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Santa da Espada, Theresia van Astrea!","i":false,"b":false}]]},{"start":1253.73,"end":1256.31,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Eu não virei mais aqui.","i":false,"b":false}]]},{"start":1261.51,"end":1263.56,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Com uma cara dessas,","i":false,"b":false}]]},{"start":1263.56,"end":1266.16,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"você não deveria estar segurando uma espada!","i":false,"b":false}]]},{"start":1267.21,"end":1269.61,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Eu sou a Santa da Espada.","i":false,"b":false}]]},{"start":1269.61,"end":1272.24,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Não entendia o motivo antes,","i":false,"b":false}]]},{"start":1272.24,"end":1273.62,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"mas agora entendo.","i":false,"b":false}]]},{"start":1274.03,"end":1276.99,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"O motivo, você diz?","i":false,"b":false}]]},{"start":1276.99,"end":1279.46,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Empunhar a espada para proteger alguém.","i":false,"b":false}]]},{"start":1280.09,"end":1283.25,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Isso também me soa bom.","i":false,"b":false}]]},{"start":1286.26,"end":1289.49,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Espere, Theresia...","i":false,"b":false}]]},{"start":1289.49,"end":1291.56,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Eu ","i":false,"b":false},{"text":"vou","i":true,"b":false},{"text":" tomar a sua espada de você!","i":false,"b":false}]]},{"start":1292.22,"end":1295.95,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Não me importa o papel imposto à Santa da Espada!","i":false,"b":false}]]},{"start":1295.95,"end":1297.85,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Não se atreva...","i":false,"b":false}]]},{"start":1298.56,"end":1301.78,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"a menosprezar empunhar a espada ou a beleza de uma lâmina de aço!","i":false,"b":false}]]},{"start":1302.49,"end":1303.86,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Está me ouvindo, Santa da Espada?!","i":false,"b":false}]]},{"start":1317.79,"end":1319.25,"align":2,"style":"Default","isSign":false,"lines":[[{"text":"Temos problemas!","i":false,"b":false}]]},{"start":1347.44,"end":1349.24,"align":2,"style":"Default","isSign":false,"lines":[[{"text