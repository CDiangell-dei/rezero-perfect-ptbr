,"i":false,"b":false}]]},{"start":377.95,"end":382.27,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Só neste ano tive que lutar mais","i":false,"b":false}],[{"text":"que muito guerreiro de baixo escalão.","i":false,"b":false}]]},{"start":382.27,"end":385.19,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Que tipo de comerciante isso faz de mim?","i":false,"b":false}]]},{"start":405.13,"end":408.5,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Bem, isso não podia ser mais nojento.","i":false,"b":false}]]},{"start":408.5,"end":411.18,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Eu não curto muito banho de sangue, sabe.","i":false,"b":false}]]},{"start":413.16,"end":415.71,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Ousa chamar uma garota de 'nojenta'?","i":false,"b":false}]]},{"start":415.71,"end":418.81,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Ninguém gosta de rapazes que","i":false,"b":false}],[{"text":"falam sem rodeios demais.","i":false,"b":false}]]},{"start":419.33,"end":424.06,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Será que todos que tramam nas","i":false,"b":false}],[{"text":"sombras são desse jeito?","i":false,"b":false}]]},{"start":424.71,"end":425.4,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Hã?","i":false,"b":false}]]},{"start":426.0,"end":429.47,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Estive pensando o tempo todo","i":false,"b":false}]]},{"start":429.47,"end":433.12,"align":2,"style":"main","isSign":false,"lines":[[{"text":"sobre a identidade do cretino","i":false,"b":false}],[{"text":"que abriu a comporta","i":false,"b":false}]]},{"start":433.12,"end":436.33,"align":2,"style":"main","isSign":false,"lines":[[{"text":"só um pouquinho e inundou","i":false,"b":false}],[{"text":"cerca de metade da cidade.","i":false,"b":false}]]},{"start":436.73,"end":438.33,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Se não fosse por isso,","i":false,"b":false}]]},{"start":438.33,"end":443.33,"align":2,"style":"main","isSign":false,"lines":[[{"text":"o rumo desta cidade já estaria","i":false,"b":false}],[{"text":"praticamente selado.","i":false,"b":false}]]},{"start":445.73,"end":448.76,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Não faço ideia do que você está falando.","i":false,"b":false}]]},{"start":449.14,"end":451.09,"align":2,"style":"main","isSign":false,"lines":[[{"text":"E além disso!","i":false,"b":false}]]},{"start":451.09,"end":454.06,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Os restos da bruxa que eu estava procurando?","i":false,"b":false}]]},{"start":454.06,"end":456.68,"align":2,"style":"main","isSign":false,"lines":[[{"text":"As pessoas que sabem onde eles estão","i":false,"b":false}]]},{"start":456.68,"end":462.49,"align":2,"style":"main","isSign":false,"lines":[[{"text":"parecem morrer uma a uma,","i":false,"b":false}],[{"text":"sem nenhum envolvimento meu!","i":false,"b":false}]]},{"start":462.49,"end":465.2,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Bem, sinto muito ouvir isso.","i":false,"b":false}]]},{"start":465.2,"end":468.94,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Mas coisas infelizes acabam","i":false,"b":false}],[{"text":"acontecendo em tempos caóticos assim.","i":false,"b":false}]]},{"start":469.28,"end":472.62,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Ah, vai se fazer de desentendido?","i":false,"b":false}]]},{"start":472.62,"end":475.69,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Tudo bem. Mesmo que aja assim,","i":false,"b":false}]]},{"start":475.69,"end":480.54,"align":2,"style":"main","isSign":false,"lines":[[{"text":"meu amor magnífico ainda vai","i":false,"b":false}],[{"text":"abraçar você com ternura...","i":false,"b":false}]]},{"start":481.29,"end":484.45,"align":2,"style":"main","isSign":false,"lines":[[{"text":"contanto que tire esse elmo,","i":fal