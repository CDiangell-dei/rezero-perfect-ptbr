 Velho Rom disse,","i":false,"b":false}]]},{"start":286.77,"end":290.12,"align":2,"style":"main","isSign":false,"lines":[[{"text":"nem mesmo o Reinhard sairia","i":false,"b":false}],[{"text":"ileso dessa coisa.","i":false,"b":false}]]},{"start":290.12,"end":293.84,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Bem, esse parece ser um","i":false,"b":false}],[{"text":"parâmetro bem claro.","i":false,"b":false}]]},{"start":293.84,"end":294.69,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Muito bem, então.","i":false,"b":false}]]},{"start":295.49,"end":297.56,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Nós ficaremos aqui e ganharemos tempo.","i":false,"b":false}]]},{"start":299.85,"end":304.01,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Enquanto eu vou buscar o metia?","i":false,"b":false}],[{"text":"Vocês conseguem aguentar até lá?","i":false,"b":false}]]},{"start":304.01,"end":307.28,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Suponho que tudo dependa da","i":false,"b":false}],[{"text":"velocidade com que correr, não é?","i":false,"b":false}]]},{"start":307.57,"end":310.0,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Certo, você me provocou.","i":false,"b":false}]]},{"start":310.0,"end":312.75,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Vou deixar o Gaston aqui.","i":false,"b":false}],[{"text":"Usem-no como precisarem.","i":false,"b":false}]]},{"start":312.75,"end":313.87,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Eu também tenho que ficar?!","i":false,"b":false}]]},{"start":316.62,"end":320.06,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Parece que vocês são mais","i":false,"b":false}],[{"text":"capazes do que pensávamos,","i":false,"b":false}]]},{"start":320.06,"end":324.01,"align":2,"style":"main","isSign":false,"lines":[[{"text":"mas uns lagartos d'água","i":false,"b":false}],[{"text":"não vão dar conta do recado.","i":false,"b":false}]]}