{"version":1,"episodeKey":"arc05-ep12","arc":"arc05","episode":"12","language":"pt-BR","sourceFormat":"ass","cues":[{"start":30.24,"end":31.51,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Você os mataria, então?","i":false,"b":false}]]},{"start":32.38,"end":35.72,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Esses seres que nunca guardaram rancor...","i":false,"b":false}]]},{"start":42.98,"end":44.89,"align":2,"style":"main","isSign":false,"lines":[[{"text":"que um dia foram simples humanos.","i":false,"b":false}]]},{"start":184.56,"end":188.7,"align":2,"style":"flashback","isSign":false,"lines":[[{"text":"No fim, este mundo inteiro","i":false,"b":false}],[{"text":"gira em torno da gula.","i":false,"b":false}]],"role":"flashback"},{"start":189.17,"end":191.25,"align":2,"style":"flashback","isSign":false,"lines":[[{"text":"Hora do banquete!","i":false,"b":false}]],"role":"flashback"},{"start":191.25,"end":193.13,"align":2,"style":"flashback","isSign":false,"lines":[[{"text":"Ao negociar com um comerciante,","i":false,"b":false}]],"role":"flashback"},{"start":193.13,"end":195.59,"align":2,"style":"flashback","isSign":false,"lines":[[{"text":"é bom ouvi-lo até que","i":false,"b":false}],[{"text":"ele termine de falar!","i":false,"b":false}]],"role":"flashback"},{"start":200.42,"end":202.89,"align":2,"style":"flashback","isSign":false,"lines":[[{"text":"Pois um comerciante sempre","i":false,"b":false}],[{"text":"tem uma carta na manga.","i":false,"b":false}]],"role":"flashback"},{"start":205.54,"end":208.31,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Dragões aquáticos são caçadores impiedosos.","i":false,"b":false}]]},{"start":219.4,"end":224.2,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Isso foi incrível! Foi você quem fez isso?","i":false,"b":false}]]},{"start":224.2,"end":227.53,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Sinto muito por terem precisado nos salvar.","i":false,"b":false}]]},{"star