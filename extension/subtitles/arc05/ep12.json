{"version":1,"episodeKey":"arc05-ep12","arc":"arc05","episode":"12","language":"pt-BR","sourceFormat":"ass","cues":[{"start":30.24,"end":31.51,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Você os mataria, então?","i":false,"b":false}]]},{"start":32.38,"end":35.72,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Esses seres que nunca guardaram rancor...","i":false,"b":false}]]},{"start":42.98,"end":44.89,"align":2,"style":"main","isSign":false,"lines":[[{"text":"que um dia foram simples humanos.","i":false,"b":false}]]},{"start":184.56,"end":188.7,"align":2,"style":"flashback","isSign":false,"lines":[[{"text":"No fim, este mundo inteiro","i":false,"b":false}],[{"text":"gira em torno da gula.","i":false,"b":false}]]},{"start":189.17,"end":191.25,"align":2,"style":"flashback","isSign":false,"lines":[[{"text":"Hora do banquete!","i":false,"b":false}]]},{"start":191.25,"end":193.13,"align":2,"style":"flashback","isSign":false,"lines":[[{"text":"Ao negociar com um comerciante,","i":false,"b":false}]]},{"start":193.13,"end":195.59,"align":2,"style":"flashback","isSign":false,"lines":[[{"text":"é bom ouvi-lo até que","i":false,"b":false}],[{"text":"ele termine de falar!","i":false,"b":false}]]},{"start":200.42,"end":202.89,"align":2,"style":"flashback","isSign":false,"lines":[[{"text":"Pois um comerciante sempre","i":false,"b":false}],[{"text":"tem uma carta na manga.","i":false,"b":false}]]},{"start":205.54,"end":208.31,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Dragões aquáticos são caçadores impiedosos.","i":false,"b":false}]]},{"start":219.4,"end":224.2,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Isso foi incrível! Foi você quem fez isso?","i":false,"b":false}]]},{"start":224.2,"end":227.53,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Sinto muito por terem precisado nos salvar.","i":false,"b":false}]]},{"start":227.84,"end":231.16,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Não vou perguntar como","i":false,"b":false}],[{"text":"controlou essas criaturas.","i":false,"b":false}]]},{"start":231.72,"end":234.04,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Eu agradeceria por isso.","i":false,"b":false}]]},{"start":234.04,"end":236.63,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Enfim, o que a traz aqui, Felt-sama?","i":false,"b":false}]]},{"start":236.97,"end":237.63,"align":2,"style":"main","isSign":false,"lines":[[{"text":"O Heinkel-san...","i":false,"b":false}]]},{"start":237.63,"end":241.07,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Deixei o Camberley vigiando","i":false,"b":false}],[{"text":"aquele velho rabugento.","i":false,"b":false}]]},{"start":241.07,"end":244.13,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Estávamos voltando para pegar","i":false,"b":false}],[{"text":"algo que deixamos na estalagem.","i":false,"b":false}]]},{"start":244.48,"end":247.1,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Algo que deixaram... na estalagem?","i":false,"b":false}]]},{"start":247.38,"end":252.22,"align":2,"style":"main","isSign":false,"lines":[[{"text":"É. Uma arma secreta que um","i":false,"b":false}],[{"text":"feiticeiro nosso me deu.","i":false,"b":false}]]},{"start":252.22,"end":255.55,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Dizem que é um metia bem poderoso.","i":false,"b":false}]]},{"start":255.55,"end":256.31,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Espere um momento.","i":false,"b":false}]]},{"start":280.75,"end":281.84,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Felt-sama...","i":false,"b":false}]]},{"start":282.11,"end":284.88,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Esse metia é confiável?","i":false,"b":false}]]},{"start":284.88,"end":286.77,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Pelo que o Velho Rom disse,","i":false,"b":false}]]},{"start":286.77,"end":290.12,"align":2,"style":"main","isSign":false,"lines":[[{"text":"nem mesmo o Reinhard sairia","i":false,"b":false}],[{"text":"ileso dessa coisa.","i":false,"b":false}]]},{"start":290.12,"end":293.84,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Bem, esse parece ser um","i":false,"b":false}],[{"text":"parâmetro bem claro.","i":false,"b":false}]]},{"start":293.84,"end":294.69,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Muito bem, então.","i":false,"b":false}]]},{"start":295.49,"end":297.56,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Nós ficaremos aqui e ganharemos tempo.","i":false,"b":false}]]},{"start":299.85,"end":304.01,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Enquanto eu vou buscar o metia?","i":false,"b":false}],[{"text":"Vocês conseguem aguentar até lá?","i":false,"b":false}]]},{"start":304.01,"end":307.28,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Suponho que tudo dependa da","i":false,"b":false}],[{"text":"velocidade com que correr, não é?","i":false,"b":false}]]},{"start":307.57,"end":310.0,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Certo, você me provocou.","i":false,"b":false}]]},{"start":310.0,"end":312.75,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Vou deixar o Gaston aqui.","i":false,"b":false}],[{"text":"Usem-no como precisarem.","i":false,"b":false}]]},{"start":312.75,"end":313.87,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Eu também tenho que ficar?!","i":false,"b":false}]]},{"start":316.62,"end":320.06,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Parece que vocês são mais","i":false,"b":false}],[{"text":"capazes do que pensávamos,","i":false,"b":false}]]},{"start":320.06,"end":324.01,"align":2,"style":"main","isSign":false,"lines":[[{"text":"mas uns lagartos d'água","i":false,"b":false}],[{"text":"não vão dar conta do recado.","i":false,"b":false}]]},{"start":324.65,"end":330.19,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Gourmets como nós costumam ser","i":false,"b":false}],[{"text":"exigentes com os aperitivos.","i":false,"b":false}]]},{"start":329.35,"end":330.19,"align":8,"style":"top","isSign":true,"lines":[[{"text":"Gaston!","i":false,"b":false}]]},{"start":330.19,"end":333.2,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Se eu morrer fazendo isso,","i":false,"b":false}],[{"text":"vou voltar para assombrar você!","i":false,"b":false}]]},{"start":339.35,"end":341.44,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Saia do nosso cam—","i":false,"b":false}]]},{"start":343.18,"end":347.4,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Ah, o fluxo de mana! Nada mal","i":false,"b":false}],[{"text":"para um cabeça-oca como você!","i":false,"b":false}]]},{"start":347.4,"end":350.16,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Quem você está chamando de cabeça-oca?!","i":false,"b":false}]]},{"start":354.91,"end":356.7,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Ah, entendemos.","i":false,"b":false}]]},{"start":356.7,"end":359.79,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Então foi com esse tipo de","i":false,"b":false}],[{"text":"plano que vieram até aqui.","i":false,"b":false}]]},{"start":361.75,"end":363.59,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Você está bem calmo.","i":false,"b":false}]]},{"start":363.59,"end":366.52,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Percebe que nada saiu a seu","i":false,"b":false}],[{"text":"favor até agora, certo?","i":false,"b":false}]]},{"start":369.03,"end":371.85,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Agora que aquela garota se foi,","i":false,"b":false}]]},{"start":371.85,"end":375.06,"align":2,"style":"main","isSign":false,"lines":[[{"text":"achamos que restam três aqui","i":false,"b":false}],[{"text":"de que a Rui pode gostar.","i":false,"b":false}]]},{"start":377.95,"end":382.27,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Só neste ano tive que lutar mais","i":false,"b":false}],[{"text":"que muito guerreiro de baixo escalão.","i":false,"b":false}]]},{"start":382.27,"end":385.19,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Que tipo de comerciante isso faz de mim?","i":false,"b":false}]]},{"start":405.13,"end":408.5,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Bem, isso não podia ser mais nojento.","i":false,"b":false}]]},{"start":408.5,"end":411.18,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Eu não curto muito banho de sangue, sabe.","i":false,"b":false}]]},{"start":413.16,"end":415.71,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Ousa chamar uma garota de 'nojenta'?","i":false,"b":false}]]},{"start":415.71,"end":418.81,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Ninguém gosta de rapazes que","i":false,"b":false}],[{"text":"falam sem rodeios demais.","i":false,"b":false}]]},{"start":419.33,"end":424.06,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Será que todos que tramam nas","i":false,"b":false}],[{"text":"sombras são desse jeito?","i":false,"b":false}]]},{"start":424.71,"end":425.4,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Hã?","i":false,"b":false}]]},{"start":426.0,"end":429.47,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Estive pensando o tempo todo","i":false,"b":false}]]},{"start":429.47,"end":433.12,"align":2,"style":"main","isSign":false,"lines":[[{"text":"sobre a identidade do cretino","i":false,"b":false}],[{"text":"que abriu a comporta","i":false,"b":false}]]},{"start":433.12,"end":436.33,"align":2,"style":"main","isSign":false,"lines":[[{"text":"só um pouquinho e inundou","i":false,"b":false}],[{"text":"cerca de metade da cidade.","i":false,"b":false}]]},{"start":436.73,"end":438.33,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Se não fosse por isso,","i":false,"b":false}]]},{"start":438.33,"end":443.33,"align":2,"style":"main","isSign":false,"lines":[[{"text":"o rumo desta cidade já estaria","i":false,"b":false}],[{"text":"praticamente selado.","i":false,"b":false}]]},{"start":445.73,"end":448.76,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Não faço ideia do que você está falando.","i":false,"b":false}]]},{"start":449.14,"end":451.09,"align":2,"style":"main","isSign":false,"lines":[[{"text":"E além disso!","i":false,"b":false}]]},{"start":451.09,"end":454.06,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Os restos da bruxa que eu estava procurando?","i":false,"b":false}]]},{"start":454.06,"end":456.68,"align":2,"style":"main","isSign":false,"lines":[[{"text":"As pessoas que sabem onde eles estão","i":false,"b":false}]]},{"start":456.68,"end":462.49,"align":2,"style":"main","isSign":false,"lines":[[{"text":"parecem morrer uma a uma,","i":false,"b":false}],[{"text":"sem nenhum envolvimento meu!","i":false,"b":false}]]},{"start":462.49,"end":465.2,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Bem, sinto muito ouvir isso.","i":false,"b":false}]]},{"start":465.2,"end":468.94,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Mas coisas infelizes acabam","i":false,"b":false}],[{"text":"acontecendo em tempos caóticos assim.","i":false,"b":false}]]},{"start":469.28,"end":472.62,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Ah, vai se fazer de desentendido?","i":false,"b":false}]]},{"start":472.62,"end":475.69,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Tudo bem. Mesmo que aja assim,","i":false,"b":false}]]},{"start":475.69,"end":480.54,"align":2,"style":"main","isSign":false,"lines":[[{"text":"meu amor magnífico ainda vai","i":false,"b":false}],[{"text":"abraçar você com ternura...","i":false,"b":false}]]},{"start":481.29,"end":484.45,"align":2,"style":"main","isSign":false,"lines":[[{"text":"contanto que tire esse elmo,","i":false,"b":false}],[{"text":"mostre o seu rosto,","i":false,"b":false}]]},{"start":484.45,"end":487.44,"align":2,"style":"main","isSign":false,"lines":[[{"text":"leve-me para a cama e me ame, claro.","i":false,"b":false}]]},{"start":489.01,"end":492.3,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Foi mal! Agradeço o sentimento,","i":false,"b":false}]]},{"start":492.3,"end":495.05,"align":2,"style":"main","isSign":false,"lines":[[{"text":"mas acho que ainda não nos","i":false,"b":false}],[{"text":"conhecemos bem o bastante.","i":false,"b":false}]]},{"start":495.61,"end":500.72,"align":2,"style":"main","isSign":false,"lines":[[{"text":"E não quero meus amigos espalhando","i":false,"b":false}],[{"text":"boatos estranhos, então vou recusar.","i":false,"b":false}]]},{"start":500.98,"end":506.48,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Não me acho uma escolha tão ruim para","i":false,"b":false}],[{"text":"um pedaço de carne macho masoquista","i":false,"b":false}]]},{"start":506.48,"end":509.94,"align":2,"style":"main","isSign":false,"lines":[[{"text":"que gosta de ser feito de","i":false,"b":false}],[{"text":"capacho por mulheres.","i":false,"b":false}]]},{"start":510.24,"end":511.66,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Hã? O que você...","i":false,"b":false}]]},{"start":511.66,"end":515.28,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Olhar severo e um corpo voluptuoso...","i":false,"b":false}]]},{"start":515.28,"end":518.53,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Temperamental e audaciosa por natureza,","i":false,"b":false}]]},{"start":518.53,"end":521.25,"align":2,"style":"main","isSign":false,"lines":[[{"text":"fala pelos cotovelos, mas tem cérebro...","i":false,"b":false}]]},{"start":521.55,"end":523.21,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Algo assim?","i":false,"b":false}]]},{"start":523.21,"end":525.76,"align":2,"style":"main","isSign":false,"lines":[[{"text":"E o comprimento do cabelo...","i":false,"b":false}]]},{"start":525.76,"end":528.97,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Ah, mas a cor não é loira?","i":false,"b":false}]]},{"start":528.97,"end":531.89,"align":2,"style":"main","isSign":false,"lines":[[{"text":"E também não é ruiva...","i":false,"b":false}]]},{"start":531.89,"end":533.42,"align":2,"style":"main","isSign":false,"lines":[[{"text":"É laranja!","i":false,"b":false}]]},{"start":533.72,"end":537.51,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Quanto à idade... Ah!","i":false,"b":false}],[{"text":"Algo mais ou menos assim, não é?","i":false,"b":false}]]},{"start":539.49,"end":541.31,"align":2,"style":"main","isSign":false,"lines":[[{"text":"E quanto à voz?","i":false,"b":false}]]},{"start":542.64,"end":544.56,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Que coisa mais repulsiva de se fazer.","i":false,"b":false}]]},{"start":545.06,"end":547.54,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Onde foi que você viu a princesa antes?!","i":false,"b":false}]]},{"start":547.54,"end":551.11,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Nunca a vi e nem sequer","i":false,"b":false}],[{"text":"sabia da existência dela,","i":false,"b":false}]]},{"start":551.11,"end":555.76,"align":2,"style":"main","isSign":false,"lines":[[{"text":"mas captar cada mínimo detalhe","i":false,"b":false}],[{"text":"seu além do rosto —","i":false,"b":false}]]},{"start":555.76,"end":561.03,"align":2,"style":"main","isSign":false,"lines":[[{"text":"seus gestos, suas reações,","i":false,"b":false}],[{"text":"sua postura — é o que faço de melhor.","i":false,"b":false}]]},{"start":561.03,"end":565.12,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Olhe para mim. Olhe apenas para mim.","i":false,"b":false}]]},{"start":565.85,"end":570.09,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Meu rosto, meu corpo, minha voz,","i":false,"b":false}],[{"text":"meus trejeitos, tudo isso...","i":false,"b":false}]]},{"start":570.45,"end":573.84,"align":2,"style":"main","isSign":false,"lines":[[{"text":"deve estar perfeitamente de","i":false,"b":false}],[{"text":"acordo com suas preferências!","i":false,"b":false}]]},{"start":576.29,"end":580.93,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Desculpa, mas a raça humana ainda não","i":false,"b":false}],[{"text":"tá pronta pra essa demonstração de amor.","i":false,"b":false}]]},{"start":580.93,"end":584.08,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Por que você resiste a mim?","i":false,"b":false}]]},{"start":584.08,"end":588.15,"align":2,"style":"main","isSign":false,"lines":[[{"text":"O que exatamente em mim","i":false,"b":false}],[{"text":"não lhe agrada?","i":false,"b":false}]]},{"start":588.15,"end":590.24,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Não entenda errado.","i":false,"b":false}]]},{"start":590.24,"end":594.16,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Não gosto nem odeio você. Nem me importo.","i":false,"b":false}]]},{"start":595.27,"end":596.49,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Ah, desculpa. É mentira.","i":false,"b":false}]]},{"start":597.04,"end":600.49,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Você é nojenta, então eu te odeio mesmo!","i":false,"b":false}]]},{"start":600.49,"end":602.7,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Seu hálito faz meus olhos arderem!","i":false,"b":false}]]},{"start":603.9,"end":607.62,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Seu pedaço de carne podre e adúltero!","i":false,"b":false}]]},{"start":613.56,"end":614.62,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Dona!","i":false,"b":false}]]},{"start":624.11,"end":624.91,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Hã?","i":false,"b":false}]]},{"start":627.93,"end":630.27,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Hora de transformar você em","i":false,"b":false}],[{"text":"uns fogos de artifício imundos!","i":false,"b":false}]]},{"start":630.59,"end":632.08,"align":2,"style":"main","isSign":false,"lines":[[{"text":"El Dona!","i":false,"b":false}]]},{"start":644.55,"end":647.11,"align":2,"style":"main","isSign":false,"lines":[[{"text":"E aí? Depois disso tudo...","i":false,"b":false}]]},{"start":646.24,"end":648.41,"align":8,"style":"top","isSign":true,"lines":[[{"text":"Ora, isso foi bem maldoso.","i":false,"b":false}]]},{"start":650.4,"end":651.63,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Merda!","i":false,"b":false}]]},{"start":651.89,"end":655.6,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Não precisava mesmo ter","i":false,"b":false}],[{"text":"ido tão longe, não é?","i":false,"b":false}]]},{"start":656.72,"end":659.01,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Qual é, isso não pode ser permitido!","i":false,"b":false}]]},{"start":659.3,"end":665.32,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Oh, céus! Que corajoso continuar lutando","i":false,"b":false}],[{"text":"mesmo quando a coisa aperta tanto!","i":false,"b":false}]]},{"start":665.32,"end":667.58,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Minha opinião sobre você","i":false,"b":false}],[{"text":"acaba de ir às alturas!","i":false,"b":false}]]},{"start":669.29,"end":674.38,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Azar o seu. A princesa deixou claro","i":false,"b":false}],[{"text":"que eu tenho que cuidar disso.","i":false,"b":false}]]},{"start":674.38,"end":677.35,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Uma mulher que vive mudando de","i":false,"b":false}],[{"text":"aparência dá medo,","i":false,"b":false}]]},{"start":677.35,"end":681.21,"align":2,"style":"main","isSign":false,"lines":[[{"text":"mas deixar a princesa de mau humor","i":false,"b":false}],[{"text":"me dá muito mais medo.","i":false,"b":false}]]},{"start":681.21,"end":684.83,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Ainda tem a audácia de falar","i":false,"b":false}],[{"text":"de outra mulher?","i":false,"b":false}]]},{"start":684.83,"end":690.79,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Parece que vou ter que lhe ensinar","i":false,"b":false}],[{"text":"bom comportamento de verdade.","i":false,"b":false}]]},{"start":690.79,"end":692.95,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Ah, droga.","i":false,"b":false}]]},{"start":693.45,"end":696.37,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Os astros estão mesmo contra mim hoje.","i":false,"b":false}]]},{"start":706.84,"end":708.39,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Onde...","i":false,"b":false}]]},{"start":720.86,"end":725.16,"align":2,"style":"flashback","isSign":false,"lines":[[{"text":"Certo, então como é esse","i":false,"b":false}],[{"text":"tal de Kurgan 'Oito-Braços'?","i":false,"b":false}]]},{"start":725.8,"end":729.79,"align":2,"style":"flashback","isSign":false,"lines":[[{"text":"Resumindo, ele é uma lenda viva.","i":false,"b":false}]]},{"start":730.33,"end":731.67,"align":2,"style":"flashback","isSign":false,"lines":[[{"text":"Lenda?","i":false,"b":false}]]},{"start":731.67,"end":732.5,"align":2,"style":"flashback","isSign":false,"lines":[[{"text":"É.","i":false,"b":false}]]},{"start":733.08,"end":738.32,"align":2,"style":"flashback","isSign":false,"lines":[[{"text":"Nós, semi-humanos, normalmente temos","i":false,"b":false}],[{"text":"uma alta aptidão para magia,","i":false,"b":false}]]},{"start":738.32,"end":742.72,"align":2,"style":"flashback","isSign":false,"lines":[[{"text":"mas a raça de muitos braços é uma","i":false,"b":false}],[{"text":"exceção com aptidão bem baixa.","i":false,"b":false}]]},{"start":743.09,"end":748.18,"align":2,"style":"flashback","isSign":false,"lines":[[{"text":"Por isso, até no Império de Vollachia,","i":false,"b":false}],[{"text":"onde semi-humanos são protegidos,","i":false,"b":false}]]},{"start":748.18,"end":751.54,"align":2,"style":"flashback","isSign":false,"lines":[[{"text":"eles sofriam muita","i":false,"b":false}],[{"text":"discriminação e escárnio.","i":false,"b":false}]]},{"start":751.54,"end":753.94,"align":2,"style":"flashback","isSign":false,"lines":[[{"text":"Foi o Kurgan quem mudou tudo isso.","i":false,"b":false}]]},{"start":754.73,"end":757.87,"align":2,"style":"flashback","isSign":false,"lines":[[{"text":"Quando os soldados do senhor","i":false,"b":false}],[{"text":"local tentaram matá-los,","i":false,"b":false}]]},{"start":757.87,"end":760.38,"align":2,"style":"flashback","isSign":false,"lines":[[{"text":"ele virou o jogo contra todos sozinho","i":false,"b":false}]]},{"start":760.38,"end":763.95,"align":2,"style":"flashback","isSign":false,"lines":[[{"text":"e fez o lorde reconhecer o","i":false,"b":false}],[{"text":"povo de muitos braços.","i":false,"b":false}]]},{"start":764.44,"end":769.58,"align":2,"style":"flashback","isSign":false,"lines":[[{"text":"A maioria dos de muitos braços nasce","i":false,"b":false}],[{"text":"com quatro ou cinco braços,","i":false,"b":false}]]},{"start":770.12,"end":775.17,"align":2,"style":"flashback","isSign":false,"lines":[[{"text":"mas Kurgan, com seus oito braços,","i":false,"b":false}],[{"text":"foi desprezado desde jovem","i":false,"b":false}]]},{"start":775.17,"end":778.46,"align":2,"style":"flashback","isSign":false,"lines":[[{"text":"e até isolado dentro da","i":false,"b":false}],[{"text":"própria tribo, ao que dizem.","i":false,"b":false}]]},{"start":779.01,"end":782.42,"align":2,"style":"flashback","isSign":false,"lines":[[{"text":"Apesar disso, ele empunhou a","i":false,"b":false}],[{"text":"espada pelo bem do seu povo.","i":false,"b":false}]]},{"start":782.42,"end":785.13,"align":2,"style":"flashback","isSign":false,"lines":[[{"text":"Fala dos Cutelos Demoníacos dele.","i":false,"b":false}]]},{"start":785.6,"end":786.34,"align":2,"style":"flashback","isSign":false,"lines":[[{"text":"Sim.","i":false,"b":false}]]},