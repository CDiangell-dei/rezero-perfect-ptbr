ext":"Hora de transformar você em","i":false,"b":false}],[{"text":"uns fogos de artifício imundos!","i":false,"b":false}]]},{"start":630.59,"end":632.08,"align":2,"style":"main","isSign":false,"lines":[[{"text":"El Dona!","i":false,"b":false}]]},{"start":644.55,"end":647.11,"align":2,"style":"main","isSign":false,"lines":[[{"text":"E aí? Depois disso tudo...","i":false,"b":false}]]},{"start":646.24,"end":648.41,"align":8,"style":"top","isSign":false,"lines":[[{"text":"Ora, isso foi bem maldoso.","i":false,"b":false}]]},{"start":650.4,"end":651.63,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Merda!","i":false,"b":false}]]},{"start":651.89,"end":655.6,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Não precisava mesmo ter","i":false,"b":false}],[{"text":"ido tão longe, não é?","i":false,"b":false}]]},{"start":656.72,"end":659.01,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Qual é, isso não pode ser permitido!","i":false,"b":false}]]},{"start":659.3,"end":665.32,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Oh, céus! Que corajoso continuar lutando","i":false,"b":false}],[{"text":"mesmo quando a coisa aperta tanto!","i":false,"b":false}]]},{"start":665.32,"end":667.58,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Minha opinião sobre você","i":false,"b":false}],[{"text":"acaba de ir às alturas!","i":false,"b":false}]]},{"start":669.29,"end":674.38,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Azar o seu. A princesa deixou claro","i":false,"b":false}],[{"text":"que eu tenho que cuidar disso.","i":false,"b":false}]]},{"start":674.38,"end":677.35,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Uma mulher que vive mudando de","i":false,"b":false}],[{"text":"aparência dá medo,","i":false,"b":false}]]},{"start":677.35,"end":681.21,"align":2,"style":"main","isSign":false,"lines":[[{"text":"mas deixar a princesa de mau humor","i":false,"b":false}],[{"text":"me dá muito mais medo.","i":false,"b":false}]]},{"start":681.21,"end":684.83,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Ainda tem a audácia de falar","i":false,"b":false}],[{"text":"de outra mulher?","i":false,"b":false}]]},{"start":684.83,"end":690.79,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Parece que vou ter que lhe ensinar","i":false,"b":false}],[{"text":"bom comportamento de verdade.","i":false,"b":false}]]},{"start":690.79,"end":692.95,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Ah, droga.","i":false,"b":false}]]},{"start":693.45,"end":696.37,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Os astros estão mesmo contra mim hoje.","i":false,"b":false}]]},{"start":706.84,"end":708.39,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Onde...","i":false,"b":false}]]},{"start":720.86,"end":725.16,"align":2,"style":"flashback","isSign":false,"lines":[[{"text":"Certo, então como é esse","i":false,"b":false}],[{"text":"tal de Kurgan 'Oito-Braços'?","i":false,"b":false}]],"role":"flashback"},{"start":725.8,"end":729.79,"align":2,"style":"flashback","isSign":false,"lines":[[{"text":"Resumindo, ele é uma lenda viva.","i":false,"b":false}]],"role":"flashback"},{"start":730.33,"end":731.67,"align":2,"style":"flashback","isSign":false,"lines":[[{"text":"Lenda?","i":false,"b":false}]],"role":"flashback"},{"start":731.67,"end":732.5,"align":2,"style":"flashback","isSign":false,"lines":[[{"text":"É.","i":false,"b":false}]],"role":"flashback"},{"start":733.08,"end":738.32,"align":2,"style":"flashback","isSign":false,"lines":[[{"text":"Nós, semi-humanos, normalmente temos","i":false,"b":false}],[{"text":"uma alta aptidão para magia,","i":false,"b":false}]],"role":"flashback"},{"start":738.32,"end":742.72,"align":2,"style":"flashback","isSign":false,"lines":[[{"text":"mas a raça de muitos braços é uma","i":false,"b":false}],[{"text":"exceção com aptidão bem baixa.","i":false,"b":false}]],"role":"flashback"},{"start":743.09,"end":748.18,"align":2,