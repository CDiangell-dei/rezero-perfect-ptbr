isso, ele empunhou a","i":false,"b":false}],[{"text":"espada pelo bem do seu povo.","i":false,"b":false}]],"role":"flashback"},{"start":782.42,"end":785.13,"align":2,"style":"flashback","isSign":false,"lines":[[{"text":"Fala dos Cutelos Demoníacos dele.","i":false,"b":false}]],"role":"flashback"},{"start":785.6,"end":786.34,"align":2,"style":"flashback","isSign":false,"lines":[[{"text":"Sim.","i":false,"b":false}]],"role":"flashback"},{"start":786.95,"end":790.39,"align":2,"style":"flashback","isSign":false,"lines":[[{"text":"Kurgan empunha múltiplas espadas","i":false,"b":false}],[{"text":"conhecidas como Cutelos Demoníacos,","i":false,"b":false}]],"role":"flashback"},{"start":790.96,"end":794.64,"align":2,"style":"flashback","isSign":false,"lines":[[{"text":"mas só as usa contra oponentes","i":false,"b":false}],[{"text":"que reconhece como dignos.","i":false,"b":false}]],"role":"flashback"},{"start":795.07,"end":797.92,"align":2,"style":"flashback","isSign":false,"lines":[[{"text":"Diz-se que, se ele sacar","i":false,"b":false}],[{"text":"todas as suas espadas,","i":false,"b":false}]],"role":"flashback"},{"start":797.92,"end":801.61,"align":2,"style":"flashback","isSign":false,"lines":[[{"text":"só isso já traz grande honra","i":false,"b":false}],[{"text":"ao seu adversário.","i":false,"b":false}]],"role":"flashback"},{"start":801.61,"end":806.2,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Ou seja, ele ainda me vê","i":false,"b":false}],[{"text":"como um pirralho, não é?","i":false,"b":false}]]},{"start":914.59,"end":916.31,"align":2,"style":"main","isSign":false,"lines":[[{"text":"O abrigo?","i":false,"b":false}]]},{"start":917.45,"end":918.75,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Por quê...","i":false,"b":false}]]},{"start":918.75,"end":920.24,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Tigre Magnífico?","i":false,"b":false}]]},{"start":931.04,"end":932.78,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Tigre Magnífico...","i":false,"b":false}]]},{"start":972.96,"end":976.78,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Eu amo você, Garfiel Tinsel.","i":false,"b":false}]]},{"start":977.6,"end":979.9,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Pois eu não amo você.","i":false,"b":false}]]},{"start":979.9,"end":984.04,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Você não é ela.","i":false,"b":false}]]},{"start":998.52,"end":1000.77,"align":2,"style":"main","isSign":false,"lines":[[{"text":"O-Obrigada...","i":false,"b":false}]]},{"start":1005.3,"end":1006.48,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Fiquem atrás.","i":false,"b":false}]]},{"start":1020.24,"end":1021.91,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Tigre Magnífico!","i":false,"b":false}]]},{"start":1022.66,"end":1024.74,"align":8,"style":"top","isSign":false,"lines":[[{"text":"Tigre Magnífico!","i":false,"b":false}]]},{"start":1024.0,"end":1027.27,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Escuta, garoto, o que você—","i":false,"b":false}]]},{"start":1026.19,"end":1028.42,"align":8,"style":"top","isSign":false,"lines":[[{"text":"Tigre Magnífico!","i":false,"b":false}]]},{"start":1029.32,"end":1031.44,"align":2,"style":"main","isSign":false,"lines":[[{"text":"T-Tigre Magnífico!","i":false,"b":false}]]},{"start":1031.44,"end":1034.22,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Dá pra ficar quieto de uma—","i":false,"b":false}]]},{"start":1032.59,"end":1034.22,"align":8,"style":"top","isSign":false,"lines":[[{"text":"Tigre Magnífico!","i":false,"b":false}]]},{"start":1034.67,"end":1035.96,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Por favor, vença!","i":false,"b":false}]]},{"start":1035.96,"end":1037.53,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Tigre Magnífico!","i":false,"b":false}]]},{"start":1037.53,"end":1039.64,"align":2,"style":"main","isSign":false,"lines":[[{"tex