{"version":1,"episodeKey":"arc05-ep04","arc":"arc05","episode":"4","language":"pt-BR","sourceFormat":"ass","cues":[{"start":1.01,"end":4.14,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Emilia, você é virgem?","i":false,"b":false}]]},{"start":4.14,"end":6.98,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Essa é a única coisa que realmente importa.","i":false,"b":false}]]},{"start":10.78,"end":15.45,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Peço desculpas. Perguntar isso tão do nada","i":false,"b":false}],[{"text":"deve tê-la deixado desconcertada.","i":false,"b":false}]]},{"start":15.45,"end":17.2,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Desculpo-me sinceramente.","i":false,"b":false}]]},{"start":18.31,"end":22.46,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Não sou como aqueles canalhas que não","i":false,"b":false}],[{"text":"conseguem assumir os próprios erros.","i":false,"b":false}]]},{"start":23.4,"end":26.42,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Bem, é importante saber pedir","i":false,"b":false}],[{"text":"desculpas com sinceridade.","i":false,"b":false}]]},{"start":26.42,"end":29.44,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Há gente demais neste mundo","i":false,"b":false}]]},{"start":29.44,"end":31.86,"align":2,"style":"main","isSign":false,"lines":[[{"text":"que não entende o que deveria ser tão óbvio.","i":false,"b":false}]]},{"start":32.5,"end":35.26,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Você realmente é uma mulher magnífica.","i":false,"b":false}]]},{"start":35.99,"end":38.56,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Agora, permita-me perguntar mais uma vez.","i":false,"b":false}]]},{"start":38.56,"end":41.47,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Emilia, você é virgem?","i":false,"b":false}]]},{"start":42.91,"end":44.29,"align":2,"style":"main","isSign":false,"lines":[[{"text":"E então, é?","i":false,"b":false}]]},{"start":45.03,"end":47.69,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Hã... O que é \"virgem\"?","i":false,"b":false}]]},{"start":47.69,"end":50.19,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Desculpe. Nunca ouvi esse termo antes.","i":false,"b":false}]]},{"start":50.47,"end":52.32,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Magnífico!","i":false,"b":false}]]},{"start":52.32,"end":55.78,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Você é a própria imagem da minha mulher ideal!","i":false,"b":false}]]},{"start":56.12,"end":58.95,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Fica claro que você tem um corpo virgem.","i":false,"b":false}]]},{"start":58.95,"end":63.31,"align":2,"style":"main","isSign":false,"lines":[[{"text":"O que importa de verdade é se você","i":false,"b":false}],[{"text":"também possui uma alma virgem.","i":false,"b":false}]]},{"start":63.31,"end":66.54,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Você me mostrou uma nova forma de pensar!","i":false,"b":false}]]},{"start":66.54,"end":67.71,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Eu mostrei?","i":false,"b":false}]]},{"start":68.0,"end":69.45,"align":2,"style":"main","isSign":false,"lines":[[{"text":"É claro.","i":false,"b":false}]]},{"start":70.24,"end":72.67,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Ora, céus. Ainda não me apresentei.","i":false,"b":false}]]},{"start":73.16,"end":75.62,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Meu nome é Regulus Corneas.","i":false,"b":false}]]},{"start":75.62,"end":77.92,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Sou seu querido marido,","i":false,"b":false}]]},{"start":77.92,"end":81.1,"align":2,"style":"main","isSign":false,"lines":[[{"text":"e você é minha amada 79ª esposa.","i":false,"b":false}]]},{"start":81.4,"end":82.14,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Hã?","i":false,"b":false}]]},{"start":82.51,"end":84.38,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Trouxe uma muda de roupas para você.","i":false,"b":false}]]},{"start":89.39,"end":93.33,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Número 184, troque as roupas da Número 79.","i":false,"b":false}]]},{"start":93.33,"end":95.7,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Ela exercerá o mesmo papel","i":false,"b":false}],[{"text":"que todas as outras.","i":false,"b":false}]]},{"start":95.7,"end":98.09,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Cuide bem dela.","i":false,"b":false}]]},{"start":99.33,"end":100.63,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Boa menina.","i":false,"b":false}]]},{"start":100.63,"end":102.95,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Você parou de sorrir,","i":false,"b":false}],[{"text":"exatamente como eu mandei.","i":false,"b":false}]]},{"start":108.25,"end":110.63,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Pois bem, vejo vocês mais tarde.","i":false,"b":false}]]},{"start":111.25,"end":112.01,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Certo...","i":false,"b":false}]]},{"start":117.85,"end":118.97,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Vamos trocar suas roupas.","i":false,"b":false}]]},{"start":118.97,"end":120.38,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Quem é você?","i":false,"b":false}]]},{"start":120.38,"end":122.27,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Sou a Número 184.","i":false,"b":false}]]},{"start":122.27,"end":124.56,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Sou esposa dele, assim como você.","i":false,"b":false}]]},{"start":124.56,"end":128.94,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Não me lembro de ter virado esposa dele...","i":false,"b":false}]]},{"start":128.94,"end":130.88,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Mas na cabeça dele, você é.","i":false,"b":false}]]},{"start":130.88,"end":133.35,"align":2,"style":"main","isSign":false,"lines":[[{"text":"E o fato de ele ter decidido","i":false,"b":false}],[{"text":"que você é esposa dele","i":false,"b":false}]]},{"start":133.35,"end":136.05,"align":2,"style":"main","isSign":false,"lines":[[{"text":"significa que o que você sente é irrelevante.","i":false,"b":false}]]},{"start":136.05,"end":136.61,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Hã?","i":false,"b":false}]]},{"start":136.61,"end":138.6,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Mas isso não faz sentido!","i":false,"b":false}]]},{"start":140.24,"end":143.99,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Ele me lembra um rei maligno","i":false,"b":false}],[{"text":"que vi uma vez em um livro.","i":false,"b":false}]]},{"start":145.26,"end":146.66,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Uma descrição bem apropriada.","i":false,"b":false}]]},{"start":146.66,"end":147.37,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Hã?","i":false,"b":false}]]},{"start":147.88,"end":150.77,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Ele de fato é um rei à sua própria maneira.","i":false,"b":false}]]},{"start":150.77,"end":153.34,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Certamente digno do título de \"Pequeno Rei\".","i":false,"b":false}]]},{"start":156.06,"end":157.23,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Vamos trocar suas roupas.","i":false,"b":false}]]},{"start":160.39,"end":162.01,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Subaru...","i":false,"b":false}]]},{"start":254.19,"end":256.27,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Gula!","i":false,"b":false}]]},{"start":265.99,"end":268.45,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Lembre-se do nosso objetivo aqui,","i":false,"b":false}],[{"text":"usuário de garotinhas!","i":false,"b":false}]]},{"start":270.62,"end":274.08,"align":2,"style":"flashback","isSign":false,"lines":[[{"text":"Se der de cara com a Gula,","i":false,"b":false}],[{"text":"não diga seu nome verdadeiro.","i":false,"b":false}]]},{"start":274.08,"end":276.48,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Qual era o nosso propósito ao vir aqui?","i":false,"b":false}]]},{"start":276.48,"end":280.36,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Ei, ei, ei! Vai mesmo querer","i":false,"b":false}],[{"text":"só fugir desse jeito?","i":false,"b":false}]]},{"start":280.36,"end":283.92,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Não tem contas a ajustar conosco, irmão?","i":false,"b":false}]]},{"start":285.13,"end":290.39,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Não há banquete mais satisfatório","i":false,"b":false}],[{"text":"do que um oponente ligado pelo destino.","i":false,"b":false}]]},{"start":290.39,"end":295.31,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Deixe-se devorar e bebericar","i":false,"b":false}],[{"text":"até nos fartarmos!","i":false,"b":false}]]},{"start":298.48,"end":301.98,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Desculpa, Rem. Aguenta mais um pouco.","i":false,"b":false}]]},{"start":301.98,"end":302.48,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Mova-se!","i":false,"b":false}]]},{"start":302.48,"end":304.1,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Cuide da Valquíria!","i":false,"b":false}]]},{"start":304.1,"end":306.16,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Não ouse perder, Juli!","i":false,"b":false}]]},{"start":308.0,"end":310.92,"align":2,"style":"main","isSign":false,"lines":[[{"text":"P-Por favor, não me solte!","i":false,"b":false}]]},{"start":318.29,"end":319.88,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Isso também é uma metia?","i":false,"b":false}]]},{"start":319.88,"end":321.68,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Subaru-sama!","i":false,"b":false}]]},{"start":326.56,"end":327.22,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Olhe!","i":false,"b":false}]]},{"start":327.84,"end":329.18,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Uma refém!","i":false,"b":false}]]},{"start":330.68,"end":332.31,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Acho que não!","i":false,"b":false}]]},{"start":336.6,"end":337.85,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Te peguei!","i":false,"b":false}]]},{"start":339.19,"end":340.77,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Acabou!","i":false,"b":false}]]},{"start":348.81,"end":350.37,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Vou vigiar os arredores.","i":false,"b":false}]]},{"start":350.37,"end":352.08,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Você fica com a criança.","i":false,"b":false}]]},{"start":352.08,"end":354.79,"align":2,"style":"main","isSign":false,"lines":[[{"text":"C-Certo... Pode deixar.","i":false,"b":false}]]},{"start":357.37,"end":361.59,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Não se preocupe. Esta moça gentil","i":false,"b":false}],[{"text":"deu um jeito naquele dragão assustador.","i":false,"b":false}]]},{"start":363.12,"end":366.05,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Você sabe onde estão as outras pessoas?","i":false,"b":false}]]},{"start":366.05,"end":368.3,"align":2,"style":"main","isSign":false,"lines":[[{"text":"N-Naquela sala.","i":false,"b":false}]]},{"start":397.04,"end":398.75,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Que diabos... é isso?","i":false,"b":false}]]},{"start":399.51,"end":401.02,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Subaru-sa—","i":false,"b":false}]]},{"start":401.02,"end":402.54,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Crusch-san?!","i":false,"b":false}]]},{"start":405.56,"end":408.26,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Por que vocês são tão simplórios assim?!","i":false,"b":false}]]},{"start":408.26,"end":409.63,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Você é...","i":false,"b":false}]]},{"start":409.63,"end":414.39,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Achou mesmo que eu era uma garotinha","i":false,"b":false}],[{"text":"refém, corajosa e frágil?","i":false,"b":false}]]},{"start":417.06,"end":418.82,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Tcharam!","i":false,"b":false}]]},{"start":420.23,"end":422.02,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Tire a perna daí.","i":false,"b":false}]]},{"start":422.34,"end":423.51,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Hã?","i":false,"b":false}]]},{"start":423.51,"end":428.76,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Agora ficou encantado com as","i":false,"b":false}],[{"text":"minhas belas pernas...","i":false,"b":false}]]},{"start":428.76,"end":431.32,"align":2,"style":"main","isSign":false,"lines":[[{"text":"ou só com esse pedaço de carne fêmea?","i":false,"b":false}]]},{"start":434.21,"end":437.29,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Ela tem mesmo um corpo tão provocante, não é?","i":false,"b":false}]]},{"start":437.71,"end":442.61,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Estou dizendo que ela não é alguém","i":false,"b":false}],[{"text":"que você mereça pisar desse jeito!","i":false,"b":false}]]},{"start":442.61,"end":443.85,"align":2,"style":"main","isSign":false,"lines":[[{"text":"É bom isso acertar!","i":false,"b":false}]]},{"start":443.85,"end":444.5,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Que seja.","i":false,"b":false}]]},{"start":460.84,"end":463.03,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Que cara é essa?","i":false,"b":false}]]},{"start":463.03,"end":466.52,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Minha beleza o deixou sem palavras?","i":false,"b":false}]]},{"start":466.52,"end":468.48,"align":2,"style":"main","isSign":false,"lines":[[{"text":"O que... é isso?","i":false,"b":false}]]},{"start":468.93,"end":472.95,"align":2,"style":"main","isSign":false,"lines":[[{"text":"O que diabos parece pra você,","i":false,"b":false}],[{"text":"pedacinho de carne?","i":false,"b":false}]]},{"start":472.95,"end":476.95,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Você não é... um dragão que","i":false,"b":false}],[{"text":"assume forma humana, é?","i":false,"b":false}]]},{"start":476.95,"end":482.77,"align":2,"style":"main","isSign":false,"lines":[[{"text":"E aí está! A irracionalidade que","i":false,"b":false}],[{"text":"prova o tamanho da sua idiotice!","i":false,"b":false}]]},{"start":500.34,"end":502.63,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Você... se transformou?","i":false,"b":false}]]},{"start":505.68,"end":510.48,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Eu sou a Arcebispa do Pecado da Luxúria","i":false,"b":false}],[{"text":"do Culto da Bruxa,","i":false,"b":false}]]},{"start":510.48,"end":513.43,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Capella Emerada Lugunica.","i":false,"b":false}]]},{"start":513.43,"end":518.66,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Vou me transformar no tipo de garota","i":false,"b":false}],[{"text":"de que você gosta, só para você.","i":false,"b":false}]]},{"start":525.23,"end":527.9,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Tenho certeza de que até um pedaço","i":false,"b":false}],[{"text":"de carne como você já entendeu","i":false,"b":false}]]},{"start":527.9,"end":530.04,"align":2,"style":"main","isSign":false,"lines":[[{"text":"o que são de verdade aquele lagarto","i":false,"b":false}],[{"text":"desmaiado ali","i":false,"b":false}]]},{"start":530.04,"end":532.97,"align":2,"style":"main","isSign":false,"lines":[[{"text":"e aquelas moscas na outra sala, não é?","i":false,"b":false}]]},{"start":532.97,"end":536.64,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Espera... Espera, espera, espera, espera!","i":false,"b":false}]]},{"start":536.64,"end":540.15,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Todas essas eram pessoas que","i":false,"b":false}],[{"text":"estavam aqui dentro, e você...","i":false,"b":false}]]},{"start":540.15,"end":544.45,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Correto! Mas demorou demais,","i":false,"b":false}],[{"text":"então não vai ganhar prêmio!","i":false,"b":false}]]},{"start":545.6,"end":551.04,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Não consigo entender isso!","i":false,"b":false}],[{"text":"Como... Como pôde fazer algo assim?!","i":false,"b":false}]]},{"start":551.04,"end":554.11,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Transformar pessoas em moscas? Pra quê?!","i":false,"b":false}]]},{"start":554.11,"end":555.61,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Você acha nojento?","i":false,"b":false}]]},{"start":555.61,"end":559.09,"align":2,"style":"main","isSign":false,"lines":[[{"text":"É revoltante! Você... Todos vocês são...","i":false,"b":false}]]},{"start":559.09,"end":560.08,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Isso mesmo.","i":false,"b":false}]]},{"start":560.08,"end":563.25,"align":2,"style":"main","isSign":false,"lines":[[{"text":"É tão nojento e repulsivo","i":false,"b":false}],[{"text":"que faz você me odiar.","i":false,"b":false}]]},{"start":563.25,"end":565.43,"align":2,"style":"main","isSign":false,"lines":[[{"text":"É exatamente isso!","i":false,"b":false}]]},{"start":565.43,"end":568.4,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Ver aquilo fez você me odiar","i":false,"b":false}],[{"text":"de forma visceral.","i":false,"b":false}]]},{"start":568.4,"end":569.75,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Essa é a resposta certa.","i":false,"b":false}]]},{"start":569.75,"end":573.38,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Ninguém conseguiria amar criaturas daquelas!","i":false,"b":false}]]},{"start":574.15,"end":576.09,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Vá em frente e me mate de uma vez.","i":false,"b":false}]]},{"start":576.09,"end":577.94,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Quê? Por quê?","i":false,"b":false}]]},{"start":577.94,"end":582.26,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Sou uma filantropa. Jamais faria","i":false,"b":false}],[{"text":"algo tão bárbaro assim.","i":false,"b":false}]]},{"start":582.26,"end":587.19,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Quero que o máximo de pessoas, pelo maior","i":false,"b":false}],[{"text":"tempo possível, o mais profundamente possível...","i":false,"b":false}]]},{"start":587.19,"end":588.69,"align":2,"style":"main","isSign":false,"lines":[[{"text":"me amem!","i":false,"b":false}]]},{"start":590.53,"end":596.15,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Entendeu? Porque esse... é... o meu... desejo.","i":false,"b":false}]]},{"start":601.43,"end":602.28,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Crusch-san!","i":false,"b":false}]]},{"start":602.28,"end":608.08,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Viu só? Você sempre acaba babando por","i":false,"b":false}],[{"text":"esse pedaço de carne porque a deseja muito!","i":false,"b":false}]]},{"start":608.08,"end":610.22,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Pare de falar besteira!","i":false,"b":false}]]},{"start":610.22,"end":611.84,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Tem outra pessoa que eu—","i":false,"b":false}]]},{"start":611.84,"end":613.55,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Ah, cala a boca!","i":false,"b":false}]]},{"start":613.55,"end":619.3,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Consegue jurar que não teve pensamentos","i":false,"b":false}],[{"text":"indecentes por um segundo sequer?!","i":false,"b":false}]]},{"start":619.3,"end":621.93,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Não dá vontade de afagar o cabelo dela?","i":false,"b":false}]]},{"start":621.93,"end":624.95,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Não está apaixonado por esses lábios?","i":false,"b":false}]]},{"start":624.95,"end":627.73,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Não ouse pegar esse desejo carnal","i":false,"b":false}]]},{"start":627.73,"end":632.16,"align":2,"style":"main","isSign":false,"lines":[[{"text":"que nem tem coragem de falar em voz alta","i":false,"b":false}],[{"text":"e fantasiá-lo de \"amor\"!","i":false,"b":false}]]},{"start":635.32,"end":638.49,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Acha que vai repetir essa besteira","i":false,"b":false}],[{"text":"mesmo depois de ver isto?","i":false,"b":false}]]},{"start":640.48,"end":644.66,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Essa mesma objeção obrigatória e protocolar?","i":false,"b":false}]]},{"start":647.0,"end":652.08,"align":2,"style":"main","isSign":false,"lines":[[{"text":"\"Eu a amo porque me encantei","i":false,"b":false}],[{"text":"com seu bom coração.\"","i":false,"b":false}]]},{"start":652.41,"end":655.33,"align":2,"style":"main","isSign":false,"lines":[[{"text":"\"Porque ela foi a única","i":false,"b":false}],[{"text":"que me enxergou como eu sou.\"","i":false,"b":false}]]},{"start":655.33,"end":657.75,"align":2,"style":"main","isSign":false,"lines":[[{"text":"\"Porque ela ficou ao meu lado","i":false,"b":false}],[{"text":"nos momentos difíceis.\"","i":false,"b":false}]]},{"start":657.75,"end":661.55,"align":2,"style":"main","isSign":false,"lines":[[{"text":"\"Porque posso ser quem realmente","i":false,"b":false}],[{"text":"sou quando estou com ela.\"","i":false,"b":false}]]},{"start":661.96,"end":666.01,"align":2,"style":"main","isSign":false,"lines":[[{"text":"\"Porque, quando estou com você,","i":false,"b":false}],[{"text":"tudo parece mais colorido.\"","i":false,"b":false}]]},{"start":666.65,"end":668.85,"align":2,"style":"main","isSign":false,"lines":[[{"text":"\"Porque não consigo mais seguir sozinho.\"","i":false,"b":false}]]},{"start":669.67,"end":671.69,"align":2,"style":"main","isSign":false,"lines":[[{"text":"\"Porque, embora minha vida","i":false,"b":false}],[{"text":"tenha sido cheia de mentiras,","i":false,"b":false}]]},{"start":672.31,"end":675.64,"align":2,"style":"main","isSign":false,"lines":[[{"text":"este sentimento é a única coisa","i":false,"b":false}],[{"text":"real que eu tenho.\"","i":false,"b":false}]]},{"start":679.32,"end":682.87,"align":2,"style":"main","isSign":false,"lines":[[{"text":"É tudo da boca para fora!","i":false,"b":false}]]},{"start":682.87,"end":685.28,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Se acha que o amor vai manter vocês dois juntos,","i":false,"b":false}]]},{"start":685.28,"end":689.16,"align":2,"style":"main","isSign":false,"lines":[[{"text":"tente continuar amando quando ela","i":false,"b":false}],[{"text":"se transformar numa mosca!","i":false,"b":false}]]},{"start":689.16,"end":691.52,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Acha que consegue? Não consegue, não é?!","i":false,"b":false}]]},{"start":691.52,"end":693.44,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Porque é nojento!","i":false,"b":false}]]},{"start":693.44,"end":696.09,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Você mesmo disse isso com todas as letras!","i":false,"b":false}]]},{"start":700.05,"end":704.05,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Só olhe para mim, pedaço de carne!","i":false,"b":false}]]},{"start":709.02,"end":714.84,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Argh, minha cabeça dói. Fiquei toda","i":false,"b":false}],[{"text":"empolgada e perdi a compostura.","i":false,"b":false}]]},{"start":715.55,"end":717.32,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Que vergonha! Hi-hi!","i":false,"b":false}]]},{"start":721.48,"end":724.64,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Ora, veja. Parece que você está quase morrendo.","i":false,"b":false}]]},{"start":724.64,"end":725.55,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Esta aqui também.","i":false,"b":false}]]},{"start":725.55,"end":727.74,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Ah, já sei!","i":false,"b":false}]]},{"start":732.4,"end":733.96,"align":2,"style":"main","isSign":false,"lines":[[{"text":"O que... você...","i":false,"b":false}]]},{"start":734.31,"end":741.01,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Vou descobrir em que tipos de pedaços","i":false,"b":false}],[{"text":"de carne horríveis vocês vão se transformar!","i":false,"b":false}]]},{"start":742.26,"end":745.22,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Dói? Hein? Dói?","i":false,"b":false}]]},{"start":745.54,"end":749.47,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Meu sangue tem sangue de dragão, sabiam?","i":false,"b":false}]]},{"start":749.47,"end":752.43,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Se sucumbirem à maldição dele,","i":false,"b":false}],[{"text":"o resultado vai ser incrível!","i":false,"b":false}]]},{"start":753.6,"end":757.93,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Qual de vocês será que aguenta mais tempo?","i":false,"b":false}]]},{"start":770.59,"end":772.0,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Ora, ora.","i":false,"b":false}]]},{"start":772.0,"end":774.13,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Nada mal mesmo.","i":false,"b":false}]]},{"start":786.16,"end":788.01,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Aberração cheia de braços insolente!","i":false,"b":false}]]},{"start":789.5,"end":791.54,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Desgraçado, pulando no meu ponto cego!","i":false,"b":false}]]},{"start":802.54,"end":803.81,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Chefe!","i":false,"b":false}]]},{"start":806.63,"end":807.45,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Entendido.","i":false,"b":false}]]},{"start":808.91,"end":812.45,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Anastasia-sama, descobri algo","i":false,"b":false}],[{"text":"muito preocupante.","i":false,"b":false}]]},{"start":812.45,"end":813.83,"align":2,"style":"main","isSign":false,"lines":[[{"text":"O que aconteceu?","i":false,"b":false}]]},{"start":814.4,"end":817.4,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Ninguém consegue contato","i":false,"b":false}],[{"text":"com o Conselho dos Dez.","i":false,"b":false}]]},{"start":817.4,"end":820.42,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Isso é, sem dúvida,","i":false,"b":false}],[{"text":"obra do Culto da Bruxa.","i":false,"b":false}]]},{"start":821.3,"end":823.63,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Kiritaka-san, cê certamente já sabe, mas...","i":false,"b":false}]]},{"start":825.09,"end":827.44,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Eu também sou um dos alvos deles.","i":false,"b":false}]]},{"start":827.44,"end":829.92,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Anastasia-sama, prepare-se para evacuar.","i":false,"b":false}]]},{"start":829.92,"end":831.6,"align":2,"style":"main","isSign":false,"lines":[[{"text":"E o que cê pretende fazer?","i":false,"b":false}]]},{"start":832.8,"end":835.68,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Cê não pode sair jogando a vida fora.","i":false,"b":false}]]},{"start":835.68,"end":837.31,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Aconteça o que acontecer, cê tem que viver.","i":false,"b":false}]]},{"start":839.57,"end":841.28,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Estou surpreso.","i":false,"b":false}]]},{"start":841.28,"end":845.15,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Achei que diria algo mais pragmático.","i":false,"b":false}]]},{"start":845.63,"end":850.4,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Surpreso por descobrir que eu não sou","i":false,"b":false}],[{"text":"um monstro sem coração viciado em dinheiro?","i":false,"b":false}]]},{"start":850.4,"end":855.58,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Eu faço negócios sob o lema","i":false,"b":false}],[{"text":"\"Sua lojinha amiga da vizinhança\".","i":false,"b":false}]]},{"start":858.72,"end":861.1,"align":2,"style":"main","isSign":false,"lines":[[{"text":"O que está havendo?! Alguém, relate!","i":false,"b":false}]]},{"start":859.6,"end":861.79,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Me desculpem! Obrigada!","i":false,"b":false}]]},{"start":862.12,"end":864.44,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Ah, que maravilhoso!","i":false,"b":false}]]},{"start":866.47,"end":871.43,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Ajudar e confiar um no outro","i":false,"b":false}],[{"text":"manteve os dois vivos.","i":false,"b":false}]]},{"start":871.43,"end":872.93,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Aplausos!","i":false,"b":false}]]},{"start":873.73,"end":875.77,"align":2,"style":"main","isSign":false,"lines":[[{"text":"A Arcebispa do Pecado da Ira...","i":false,"b":false}]]},{"start":877.1,"end":879.79,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Ah, você sabe quem eu sou?","i":false,"b":false}]]},{"start":879.79,"end":882.32,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Agora fiquei um pouco sem graça.","i":false,"b":false}]]},{"start":882.32,"end":885.78,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Espero que o que ouviu sobre mim","i":false,"b":false}],[{"text":"não tenha sido só coisas ruins.","i":false,"b":false}]]},{"start":885.78,"end":890.11,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Eu sou Sirius Romanée-Conti, da Ira.","i":false,"b":false}]]},{"start":890.9,"end":893.07,"align":2,"style":"main","isSign":false,"lines":[[{"text":"É um prazer enorme conhecê-la.","i":false,"b":false}]]},{"start":893.51,"end":894.58,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Consegue ficar de pé?","i":false,"b":false}]]},{"start":901.57,"end":902.86,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Anastasia-sama!","i":false,"b":false}]]},{"start":911.72,"end":913.43,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Hetaro! Tivey!","i":false,"b":false}]]},{"start":913.43,"end":914.55,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Senhorita!","i":false,"b":false}]]},{"start":914.55,"end":916.11,"align":2,"style":"main","isSign":false,"lines":[[{"text":"A senhora está bem?","i":false,"b":false}]]},{"start":916.11,"end":918.97,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Tô bem! Mas e a Mimi?","i":false,"b":false}],[{"text":"Não me diga que—","i":false,"b":false}]]},{"start":918.97,"end":920.69,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Nyão","i":true,"b":false},{"text":" morreu, Anastasia-sama!","i":false,"b":false}]]},{"start":921.0,"end":922.9,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Usei um método proibido!","i":false,"b":false}]]},{"start":922.9,"end":925.32,"align":2,"style":"main","isSign":false,"lines":[[{"text":"O mesmo que fiz na perna do Subaru-","i":false,"b":false},{"text":"kyun","i":true,"b":false},{"text":"!","i":false,"b":false}]]},{"start":926.41,"end":927.4,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Senhorita!","i":false,"b":false}]]},{"start":927.4,"end":929.38,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Precisamos continuar olhando pra frente!","i":false,"b":false}]]},{"start":929.38,"end":934.03,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Nossa irmã mandou proteger a senhora,","i":false,"b":false}],[{"text":"não importa o quanto nos doesse!","i":false,"b":false}]]},{"start":934.03,"end":936.56,"align":2,"style":"main","isSign":false,"lines":[[{"text":"E a senhora? O que vai fazer?","i":false,"b":false}]]},{"start":937.59,"end":938.83,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Eu vou...","i":false,"b":false}]]},{"start":941.69,"end":944.92,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Eu ganho tempo! Dois minutos bastam?","i":false,"b":false}]]},{"start":944.92,"end":948.07,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Como diria a nossa irmã,","i":false,"b":false}],[{"text":"\"Deixem tudo com a gente!\"","i":false,"b":false}]]},{"start":948.07,"end":950.63,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Vai ser incrível se a gente","i":false,"b":false}],[{"text":"conseguir passar por essa!","i":false,"b":false}]]},{"start":950.63,"end":953.89,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Ah, que amor fraternal adorável!","i":false,"b":false}]]},{"start":953.89,"end":956.05,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Vocês são gêmeos?","i":false,"b":false}]]},{"start":956.05,"end":957.28,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Desculpe, mas...","i":false,"b":false}]]},{"start":957.28,"end":959.52,"align":2,"style":"main","isSign":false,"lines":[[{"text":"...somos os irmãos mais novos","i":false,"b":false}],[{"text":"de um trio de trigêmeos!","i":false,"b":false}]]},{"start":959.52,"end":962.05,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Ferris-san! Tire a Mimi e os outros daqui!","i":false,"b":false}]]},{"start":962.05,"end":963.19,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Encontro vocês lá fora!","i":false,"b":false}]]},{"start":963.19,"end":964.23,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Entendido!","i":false,"b":false}]]},{"start":967.3,"end":968.14,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Jovem mestre!","i":false,"b":false}]]},{"start":968.14,"end":968.69,"align":2,"style":"main","isSign":false,"lines":[[{"text":"O senhor está bem?!","i":false,"b":false}]]},{"start":969.63,"end":973.3,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Saiam por ali. Meus homens e eu","i":false,"b":false}],[{"text":"vamos mantê-la ocupada.","i":false,"b":false}]]},{"start":978.13,"end":982.79,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Anastasia-sama, confio a cidade","i":false,"b":false}],[{"text":"de Priestella a você.","i":false,"b":false}]]},{"start":985.75,"end":988.6,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Proteja esta bela cidade das águas","i":false,"b":false}]]},{"start":988.6,"end":993.26,"align":2,"style":"main","isSign":false,"lines":[[{"text":"e nossa amada cantora","i":false,"b":false}],[{"text":"desses vilões hediondos.","i":false,"b":false}]]},{"start":994.8,"end":997.13,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Isso não é justo, não...","i":false,"b":false}]]},{"start":1008.8,"end":1010.11,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Quer um gole?","i":false,"b":false}]]},{"start":1010.11,"end":1013.29,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Não fale comigo. Você fede a bebida.","i":false,"b":false}]]},{"start":1025.46,"end":1027.9,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Eca, um zodda?","i":false,"b":false}]]},{"start":1036.73,"end":1038.18,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Desculpa!","i":false,"b":false}]]},{"start":1044.64,"end":1046.87,"align":2,"style":"main","isSign":false,"lines":[[{"text":"E então, o que vai fazer?","i":false,"b":false}]]},{"start":1046.87,"end":1049.36,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Matar o seu próprio pai?","i":false,"b":false}]]},{"start":1050.87,"end":1051.36,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Ei.","i":false,"b":false}]]},{"start":1053.37,"end":1054.61,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Felt-sama...","i":false,"b":false}]]},{"start":1056.51,"end":1057.99,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Esqueça. Só amarre ele.","i":false,"b":false}]]},{"start":1060.4,"end":1064.75,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Nossa, fiquei sentada na mesma posição","i":false,"b":false}],[{"text":"por tempo demais. Minha bunda tá doendo.","i":false,"b":false}]]},{"start":1066.07,"end":1068.58,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Eu não tinha muita certeza de qual","i":false,"b":false}],[{"text":"era a situação aqui dentro.","i":false,"b":false}]]},{"start":1069.18,"end":1071.2,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Deu tudo certo?","i":false,"b":false}]]},{"start":1071.2,"end":1073.21,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Você é amigo do Subaru...","i":false,"b":false}]]},{"start":1074.67,"end":1078.72,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Entendi. Esses insetos zodda vieram de você.","i":false,"b":false}]]},{"start":1078.72,"end":1080.4,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Obrigado. Você nos salvou.","i":false,"b":false}]]},{"start":1080.4,"end":1082.26,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Salvou coisa nenhuma!","i":false,"b":false}]]},{"start":1082.26,"end":1086.99,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Eu teria sentido menos medo de morrer","i":false,"b":false}],[{"text":"com uma espada apontada pra minha cara!","i":false,"b":false}]]},{"start":1086.99,"end":1088.52,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Quero indenização!","i":false,"b":false}]]},{"start":1088.86,"end":1092.42,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Tenho quase certeza de que acabei","i":false,"b":false}],[{"text":"de salvar a sua vida, mas...","i":false,"b":false}]]},{"start":1092.42,"end":1093.18,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Hmpf!","i":false,"b":false}]]},{"start":1093.86,"end":1095.67,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Por que está aqui?","i":false,"b":false}]]},{"start":1095.67,"end":1098.4,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Pensei que estivesse com o Subaru.","i":false,"b":false}]]},{"start":1098.4,"end":1100.32,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Foi pura coincidência, na verdade.","i":false,"b":false}]]},{"start":1101.0,"end":1104.24,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Eu só estava procurando um lugar","i":false,"b":false}],[{"text":"para me esconder.","i":false,"b":false}]]},{"start":1104.79,"end":1108.21,"align":2,"style":"main","isSign":false,"lines":[[{"text":"O Arcebispo do Pecado da Gula?","i":false,"b":false}],[{"text":"Estou impressionado que esteja vivo.","i":false,"b":false}]]},{"start":1108.21,"end":1111.28,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Tudo graças às Escamas do Dragão Branco.","i":false,"b":false}]]},{"start":1111.28,"end":1114.1,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Se eles não estivessem lá, eu estaria...","i":false,"b":false}]]},{"start":1115.14,"end":1116.89,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Como estão o Subaru e os outros?","i":false,"b":false}]]},{"start":1116.89,"end":1118.49,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Não sei.","i":false,"b":false}]]},{"start":1118.49,"end":1122.51,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Do jeito que ele é, tenho certeza","i":false,"b":false}],[{"text":"de que está resistindo teimosamente.","i":false,"b":false}]]},{"start":1122.51,"end":1124.26,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Ei, paspalho.","i":false,"b":false}]]},{"start":1124.88,"end":1127.02,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Não tem mais com o que se preocupar aqui, né?","i":false,"b":false}]]},{"start":1127.02,"end":1129.35,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Então vá lá fora ajudar ele!","i":false,"b":false}]]},{"start":1129.71,"end":1131.88,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Não, eu ficarei—","i":false,"b":false}]]},{"start":1131.11,"end":1134.52,"align":8,"style":"top","isSign":true,"lines":[[{"text":"Acha mesmo que vai me salvar","i":false,"b":false}],[{"text":"depois do inferno que acabei de passar?","i":false,"b":false}]]},{"start":1135.6,"end":1139.28,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Eu levo esse sujeito e vou","i":false,"b":false}],[{"text":"pro abrigo mais próximo.","i":false,"b":false}]]},{"start":1139.28,"end":1143.0,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Então trate de ir lá fora","i":false,"b":false}],[{"text":"e dar um jeito nessa palhaçada!","i":false,"b":false}]]},{"start":1144.3,"end":1145.5,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Reinhard!","i":false,"b":false}]]},{"start":1146.3,"end":1147.22,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Entendido.","i":false,"b":false}]]},{"start":1147.89,"end":1149.96,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Por favor, tente não ser imprudente.","i":false,"b":false}]]},{"start":1149.96,"end":1152.41,"align":2,"style":"main","isSign":false,"lines":[[{"text":"E é bom você ser imprudente mesmo!","i":false,"b":false}]]},{"start":1152.41,"end":1154.17,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Mostre do que você é capaz!","i":false,"b":false}]]},{"start":1159.84,"end":1162.84,"align":2,"style":"main","isSign":false,"lines":[[{"text":"E agora... o que a gente faz, hein?","i":false,"b":false}]]},{"start":1162.84,"end":1164.83,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Acho que não consigo carregar você nas costas.","i":false,"b":false}]]},{"start":1164.83,"end":1167.9,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Por que eu tenho que fazer trabalho de recado?","i":false,"b":false}]]},{"start":1167.9,"end":1169.46,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Que escolha a gente tinha?","i":false,"b":false}]]},{"start":1169.46,"end":1172.31,"align":2,"style":"main","isSign":false,"lines":[[{"text":"O abrigo está quase sem comida.","i":false,"b":false}]]},{"start":1175.02,"end":1176.73,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Acho que é a primeira vez","i":false,"b":false}]]},{"start":1176.73,"end":1180.2,"align":2,"style":"main","isSign":false,"lines":[[{"text":"que vocês aparecem exatamente","i":false,"b":false}],[{"text":"na hora certa!","i":false,"b":false}]]},{"start":1182.66,"end":1183.74,"align":2,"style":"main","isSign":false,"lines":[[{"text":"E agora?!","i":false,"b":false}]]},{"start":1184.23,"end":1185.83,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Quando foi que eles...","i":false,"b":false}]]},{"start":1187.79,"end":1189.67,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Opa, opa! Isso não tem graça nenhuma!","i":false,"b":false}]]},{"start":1189.67,"end":1190.71,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Para o alto!","i":false,"b":false}]]},{"start":1205.54,"end":1206.64,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Garfiel-dono!","i":false,"b":false}]]},{"start":1208.33,"end":1211.23,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Droga! Que diabos está acontecendo?!","i":false,"b":false}]]},{"start":1227.28,"end":1228.33,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Chefe?!","i":false,"b":false}]]},{"start":1233.47,"end":1234.62,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Espera!","i":false,"b":false}]]},{"start":1251.34,"end":1253.75,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Chefe!","i":false,"b":false}]]},{"start":1252.93,"end":1256.94,"align":2,"style":"Episode Title","isSign":true,"lines":[[{"text":"Uma Torrente Sombria","i":false,"b":false}]]},{"start":1351.95,"end":1355.16,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Não... A cidade...","i":false,"b":false}]]},{"start":1355.88,"end":1357.64,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Não deve fazer essa expressão.","i":false,"b":false}]]},{"start":1357.64,"end":1359.38,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Nosso querido marido não vai gostar.","i":false,"b":false}]]},{"start":1359.38,"end":1361.38,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Do que você está falando?!","i":false,"b":false}],[{"text":"Agora não é hora para—","i":false,"b":false}]]},{"start":1361.38,"end":1364.54,"align":2,"style":"italics","isSign":false,"lines":[[{"text":"Alô, alô! Olá, pedaços de carne!","i":false,"b":false}]]},{"start":1364.54,"end":1365.17,"align":2,"style":"main","isSign":false,"lines":[[{"text":"O que é isso?","i":false,"b":false}]]},{"start":1364.54,"end":1368.51,"align":8,"style":"italicstop","isSign":true,"lines":[[{"text":"Ainda estão todos entocados","i":false,"b":false}],[{"text":"e tremendo de medo?","i":false,"b":false}]]},{"start":1368.51,"end":1373.64,"align":2,"style":"italics","isSign":false,"lines":[[{"text":"Estão ouvindo a bela voz da Arcebispa","i":false,"b":false}],[{"text":"do Pecado da Luxúria, Capella-chan-sama!","i":false,"b":false}]]},{"start":1374.99,"end":1377.6,"align":2,"style":"italics","isSign":false,"lines":[[{"text":"Pois é, mesmo depois de tudo que eu disse,","i":false,"b":false}]]},{"start":1377.6,"end":1382.37,"align":2,"style":"italics","isSign":false,"lines":[[{"text":"um monte de pedaços de carne","i":false,"b":false}],[{"text":"ainda invadiu este lugar atrás de mim!","i":false,"b":false}]]},{"start":1382.37,"end":1384.42,"align":2,"style":"italics","isSign":false,"lines":[[{"text":"Eles me feriram,","i":false,"b":false}]]},{"start":1384.42,"end":1391.06,"align":2,"style":"italics","isSign":false,"lines":[[{"text":"então agora tenho mais três exigências","i":false,"b":false}],[{"text":"além dos restos mortais da bruxa!","i":false,"b":false}]]},{"start":1391.06,"end":1396.63,"align":2,"style":"italics","isSign":false,"lines":[[{"text":"Primeiro, tragam o Livro da Sabedoria","i":false,"b":false}],[{"text":"que foi trazido para esta cidade.","i":false,"b":false}]]},{"start":1396.63,"end":1402.37,"align":2,"style":"italics","isSign":false,"lines":[[{"text":"Segundo, tragam o espírito artificial","i":false,"b":false}],[{"text":"que anda passeando por esta cidade.","i":false,"b":false}]]},{"start":1402.37,"end":1403.75,"align":2,"style":"italics","isSign":false,"lines":[[{"text":"E por último...","i":false,"b":false}]]},{"start":1404.08,"end":1408.71,"align":2,"style":"italics","isSign":false,"lines":[[{"text":"O casamento com a garota de cabelos prateados","i":false,"b":false}],[{"text":"que vai acontecer nesta cidade!","i":false,"b":false}]]},{"start":1409.09,"end":1412.16,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Em resumo: nem tentem interferir.","i":false,"b":false}]]},{"start":1412.16,"end":1414.68,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Não que eu me importe, mas...","i":false,"b":false}]]}]}
