nes":[[{"text":"Sua Autoridade não é invencibilidade.","i":false,"b":false}]]},{"start":1366.79,"end":1369.22,"align":2,"style":"main","isSign":false,"lines":[[{"text":"É parar o tempo, não é?","i":false,"b":false}]]},{"start":1370.01,"end":1374.84,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Com o tempo parado para o seu corpo,","i":false,"b":false}],[{"text":"você não sofre mudanças.","i":false,"b":false}]]},{"start":1374.84,"end":1377.6,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Não se fere, e nem a água","i":false,"b":false}],[{"text":"consegue molhar você.","i":false,"b":false}]]},{"start":1377.6,"end":1380.76,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Como o tempo está parado, qualquer","i":false,"b":false}],[{"text":"areia ou água jogada em você...","i":false,"b":false}]]},{"start":1380.76,"end":1382.16,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Escute aqui!","i":false,"b":false}]]},{"start":1382.16,"end":1385.82,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Não tenho o menor interesse","i":false,"b":false}],[{"text":"nas suas ideias!","i":false,"b":false}]]},{"start":1386.37,"end":1389.86,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Perdi meu tempo ouvindo você! Francamente!","i":false,"b":false}]]},{"start":1397.76,"end":1402.96,"align":2,"style":"italics","isSign":false,"lines":[[{"text":"Aquele lugar é o pequeno reino","i":false,"b":false}],[{"text":"onde vivem as esposas do Pequeno Rei.","i":false,"b":false}]]},{"start":1403.46,"end":1406.92,"align":2,"style":"italics","isSign":false,"lines":[[{"text":"Até a Autoridade do Regulus","i":false,"b":false}],[{"text":"precisa ter limites!","i":false,"b":false}]]},{"start":1407.34,"end":1409.51,"align":2,"style":"italics","isSign":false,"lines":[[{"text":"O número de esposas, ou a distância","i":false,"b":false}],[{"text":"que ele está delas...","i":false,"b":false}]]},{"start":1409.51,"end":1411.88,"align":2,"style":"italics","isSign":false,"lines":[[{"text":"Deve existir alguma condição para isso!","i":false,"b":false}]]},{"start":1412.36,"end":1414.22,"align":2,"style":"italics","isSign":false,"lines":[[{"text":"Conto com você, Emilia!","i":false,"b":false}]]},{"start":1414.54,"end":1418.63,"align":2,"style":"italics","isSign":false,"lines":[[{"text":"Você precisa tirar essas esposas","i":false,"b":false}],[{"text":"do pequeno reino!","i":false,"b":false}]]}]}
