eal alcançado","i":false,"b":false}],[{"text":"ao compartilhar emoções?","i":false,"b":false}]]},{"start":347.79,"end":349.24,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Você é nojenta!","i":false,"b":false}]]},{"start":349.84,"end":351.95,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Se quiser mesmo se compreender","i":false,"b":false}],[{"text":"com alguém,","i":false,"b":false}]]},{"start":352.41,"end":355.58,"align":2,"style":"main","isSign":false,"lines":[[{"text":"cale essa boca e escute a minha canção!","i":false,"b":false}]]},{"start":360.4,"end":362.5,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Enfim revelou sua verdadeira face.","i":false,"b":false}]]},{"start":363.07,"end":363.96,"align":2,"style":"main","isSign":false,"lines":[[{"text":"O quê?","i":false,"b":false}]]},{"start":363.96,"end":367.3,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Você só queria silenciar","i":false,"b":false}],[{"text":"o que lhe era inconveniente.","i":false,"b":false}]]},{"start":367.3,"end":372.3,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Deixando-me de lado, o fato de não ter","i":false,"b":false}],[{"text":"funcionado na cantora claramente a irrita.","i":false,"b":false}]]},{"start":373.08,"end":373.87,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Não...","i":false,"b":false}]]},{"start":373.87,"end":375.81,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Não, não! Não, não, não, não!","i":false,"b":false}]]},{"start":375.81,"end":377.64,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Por favor! Não seja ridícula!","i":false,"b":false}]]},{"start":378.0,"end":381.36,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Eu jamais cederia a um impulso como...","i":false,"b":false}]]},{"start":381.61,"end":385.19,"align":2,"style":"main","isSign":false,"lines":[[{"text":"Bastou ouvir algo que soou","i":false,"b":false}],[{"text":"desagradável aos seus ouvidos","i":f